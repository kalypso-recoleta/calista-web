---
import GuiaBody from '../../components/pages/GuiaBody.astro';
import { guiasPublicadas } from '../../lib/guias';
export async function getStaticPaths() {
  return (await guiasPublicadas()).map((g) => ({ params: { slug: g.slug }, props: { guia: g.entry, slug: g.slug } }));
}
const { guia, slug } = Astro.props;
---
<GuiaBody guia={guia} slug={slug} />
