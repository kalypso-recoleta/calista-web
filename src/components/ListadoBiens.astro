---
import type { CollectionEntry } from 'astro:content';
import BienesFiltrados from './BienesFiltrados.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
  eyebrow: string;
  titulo: string;
  intro?: string;
  biens: CollectionEntry<'biens'>[];
  mostrarDormitorios?: boolean;
  mostrarBanos?: boolean;
  sinFiltros?: boolean;
  tituloLista?: string;
  ocultarVacia?: boolean;
  volver?: { href: string; label: string };
}
const {
  eyebrow,
  titulo,
  intro,
  biens,
  mostrarDormitorios = true,
  mostrarBanos = true,
  sinFiltros = false,
  tituloLista,
  ocultarVacia = false,
  volver,
} = Astro.props;
---

<section class="section">
  <div class="container">
    <header class="cab">
      {volver && <a class="volver" href={volver.href}>← {volver.label}</a>}
      <p class="eyebrow">{eyebrow}</p>
      <h1>{titulo}</h1>
      {intro && <p class="lead">{intro}</p>}
      <slot />
    </header>

    <slot name="intro" />
    {tituloLista && <h2 class="titulo-lista">{tituloLista}</h2>}

    {
      biens.length === 0 ? (
        !ocultarVacia && <p class="lead">{t('lista.vacia')}</p>
      ) : (
        <BienesFiltrados
          biens={biens}
          mostrarDormitorios={mostrarDormitorios}
          mostrarBanos={mostrarBanos}
          sinFiltros={sinFiltros}
        >
          <slot name="destacados" slot="destacados" />
        </BienesFiltrados>
      )
    }
  </div>
</section>

<style>
  .titulo-lista {
    margin: 0 0 1.3rem;
    padding-left: 0.9rem;
    border-left: 4px solid var(--violet);
  }
  .cab {
    max-width: 62ch;
    margin-bottom: 2rem;
  }
  .volver { display: inline-block; margin-bottom: 0.8rem; font-size: 0.9rem; font-weight: 600; color: var(--violet); text-decoration: none; }
  .volver:hover { text-decoration: underline; }
  .cab h1 {
    margin-bottom: 0.4rem;
  }
</style>
