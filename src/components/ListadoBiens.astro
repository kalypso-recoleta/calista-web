---
import type { CollectionEntry } from 'astro:content';
import BienesFiltrados from './BienesFiltrados.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
  eyebrow: string;
  titulo: string;
  intro?: string;
  biens: CollectionEntry<'biens'>[];
  mostrarDormitorios?: boolean;
  mostrarBanos?: boolean;
}
const {
  eyebrow,
  titulo,
  intro,
  biens,
  mostrarDormitorios = true,
  mostrarBanos = true,
} = Astro.props;
---

<section class="section">
  <div class="container">
    <header class="cab">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{titulo}</h1>
      {intro && <p class="lead">{intro}</p>}
      <slot />
    </header>

    <div class:list={['cuerpo', { 'con-panel': Astro.slots.has('aside') }]}>
    <div class="principal">
    {
      biens.length === 0 ? (
        <p class="lead">{t('lista.vacia')}</p>
      ) : (
        <BienesFiltrados
          biens={biens}
          mostrarDormitorios={mostrarDormitorios}
          mostrarBanos={mostrarBanos}
        />
      )
    }
    </div>
    <slot name="aside" />
    </div>
  </div>
</section>

<style>
  .cab {
    max-width: 62ch;
    margin-bottom: 2rem;
  }
  .cab h1 {
    margin-bottom: 0.4rem;
  }
  /* Avec panneau latéral « Destacados » : liste à gauche, panneau à droite */
  .con-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 290px;
    gap: 2rem;
    align-items: start;
  }
  @media (max-width: 1000px) {
    .con-panel {
      grid-template-columns: 1fr;
    }
  }
</style>
