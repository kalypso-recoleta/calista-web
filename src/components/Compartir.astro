---
/**
 * Barre de partage d'un article : WhatsApp, Facebook, LinkedIn, e-mail,
 * et « Copier le lien » (sur mobile : menu de partage du téléphone).
 */
import { getLangFromUrl } from '../i18n/utils';
interface Props { titulo: string; url: string }
const { titulo, url } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const x = {
  es: { t: 'Compartir', copiar: 'Copiar enlace', ok: '¡Enlace copiado!', mas: 'Más opciones' },
  fr: { t: 'Partager', copiar: 'Copier le lien', ok: 'Lien copié !', mas: 'Plus d’options' },
  en: { t: 'Share', copiar: 'Copy link', ok: 'Link copied!', mas: 'More options' },
}[lang as 'es' | 'fr' | 'en']!;
const u = encodeURIComponent(url);
const tt = encodeURIComponent(titulo);
const redes = [
  { n: 'WhatsApp', href: `https://wa.me/?text=${encodeURIComponent(`${titulo} ${url}`)}`, c: '#25D366', d: 'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.2.3.7 1.2 1.6 2 1.1 1 2 1.3 2.3 1.4.3.1.5.1.6-.1l.9-1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.2z' },
  { n: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${u}`, c: '#1877F2', d: 'M14 9V7c0-.9.6-1 1-1h2V2.1L14.3 2C11.3 2 10.6 4.2 10.6 5.7V9H8v4h2.6v9H14v-9h2.8l.4-4H14z' },
  { n: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`, c: '#0A66C2', d: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3V9.5zm7 0h3.8v1.6h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.2c0-1.2 0-2.9-1.8-2.9s-2 1.4-2 2.8V21h-4V9.5z' },
  { n: 'E-mail', href: `mailto:?subject=${tt}&body=${u}`, c: '#4b2a6b', d: 'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm9 7.2L4.4 7H4v.6l8 5.4 8-5.4V7h-.4L12 12.2z' },
];
---

<div class="compartir">
  <span class="tit">{x.t}</span>
  {redes.map((r) => (
    <a href={r.href} target="_blank" rel="noopener" aria-label={`${x.t}: ${r.n}`} title={r.n} style={`--c:${r.c}`}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={r.d} /></svg>
    </a>
  ))}
  <button type="button" data-copiar={url} data-ok={x.ok} data-titulo={titulo} title={x.copiar} aria-label={x.copiar} style="--c:#4b2a6b">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7" /><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7" /></svg>
    <span class="ok" data-msg hidden></span>
  </button>
</div>

<style>
  .compartir { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 1.6rem; }
  .tit { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin-right: 0.3rem; }
  a, button { position: relative; display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line); background: #fff; color: var(--c); cursor: pointer; transition: background 0.15s, color 0.15s; }
  a:hover, button:hover { background: var(--c); color: #fff; border-color: var(--c); }
  .ok { position: absolute; left: 50%; top: -2.1rem; transform: translateX(-50%); white-space: nowrap; background: var(--brand); color: #fff; font-size: 0.78rem; padding: 0.25rem 0.55rem; border-radius: 6px; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.dataset.copiar || location.href;
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        const tmp = document.createElement('textarea');
        tmp.value = url;
        document.body.appendChild(tmp);
        tmp.select();
        document.execCommand('copy');
        tmp.remove();
      }
      const msg = btn.querySelector<HTMLElement>('[data-msg]');
      if (msg) {
        msg.textContent = btn.dataset.ok || 'OK';
        msg.hidden = false;
        setTimeout(() => (msg.hidden = true), 2000);
      }
    });
  });
</script>
