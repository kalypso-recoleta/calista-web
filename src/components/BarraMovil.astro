---
/**
 * Barre fixe en bas de l'écran, sur téléphone uniquement.
 * - WhatsApp (numéro d'Hélène sur les pages propriétaires, sinon le numéro général)
 * - « Soy propietario » → page Administración (masqué sur les pages propriétaires)
 */
import { getLangFromUrl, useTranslations, localizePath, stripLocale } from '../i18n/utils';
import { whatsappLink, numeroPorRuta, esRutaPropietario } from '../lib/whatsapp';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const basePath = stripLocale(Astro.url.pathname).replace(/\/$/, '') || '/';
const wa = whatsappLink(t('nav.wa_consulta'), numeroPorRuta(basePath));
const propietario = esRutaPropietario(basePath);
---

<div class="barra-movil" role="region" aria-label="WhatsApp">
  {!propietario && <a class="prop" href={localizePath('/administracion', lang)}>{t('barra.propietarios')}</a>}
  <a class="wa" href={wa} target="_blank" rel="noopener">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm5.8 14.01c-.24.68-1.42 1.31-1.95 1.36-.5.05-1.13.07-1.83-.11-.42-.13-.96-.31-1.66-.61-2.92-1.26-4.83-4.2-4.98-4.4-.15-.2-1.19-1.58-1.19-3.01 0-1.43.75-2.13 1.02-2.42.27-.29.59-.36.78-.36.2 0 .39 0 .56.01.18.01.42-.07.66.5.24.59.83 2.02.9 2.17.07.15.12.32.02.51-.1.2-.15.32-.29.49-.15.17-.31.39-.44.52-.15.15-.3.31-.13.6.17.29.76 1.25 1.63 2.03 1.12 1 2.06 1.31 2.35 1.46.29.15.46.12.63-.07.17-.2.73-.85.92-1.14.2-.29.39-.24.66-.15.27.1 1.71.81 2 .96.29.15.49.22.56.34.07.12.07.7-.17 1.38z"/></svg>
    WhatsApp
  </a>
</div>

<style>
  .barra-movil { display: none; }
  @media (max-width: 760px) {
    .barra-movil {
      display: flex; gap: 0.6rem;
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
      padding: 0.6rem 16px calc(0.6rem + env(safe-area-inset-bottom));
      background: rgba(255, 255, 255, 0.97);
      border-top: 1px solid var(--line);
      box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.06);
    }
    .barra-movil a {
      flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 0.45rem;
      min-height: 46px; border-radius: var(--radius-sm); font-weight: 700; text-decoration: none;
    }
    .wa { background: #1f9d55; color: #fff; }
    .prop { border: 1.5px solid var(--violet); color: var(--violet); background: #fff; }
    /* Laisse la place à la barre en bas de page */
    :global(body) { padding-bottom: calc(66px + env(safe-area-inset-bottom)); }
  }
</style>
