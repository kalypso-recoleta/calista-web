---
import { resolverUbicacion, coordsCiudad } from '../lib/geo';
import { site } from '../lib/site';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
  ubicacion?: string;
  zona?: string; // libellé affiché (ex. "Villa Morra, Asunción")
  ciudad?: string; // ville de l'annonce → centre de secours
}
const { ubicacion, zona, ciudad } = Astro.props;
// Résolu au build : point cliqué dans l'admin (GeoJSON), lien Google Maps,
// "lat,lng"… Sinon on centre sur la ville de l'annonce, sinon Asunción.
const resuelto = await resolverUbicacion(ubicacion);
const punto = resuelto ?? (ciudad ? coordsCiudad[ciudad] : undefined) ?? site.mapaCentro;
const hayPunto = resuelto !== null;
// Lien Google Maps vers le même point approximatif (ouvre l'app sur téléphone)
const googleMaps = `https://www.google.com/maps/search/?api=1&query=${punto.lat},${punto.lng}`;
---

<div class="mapa-wrap">
  <div
    id="mapa"
    data-lat={punto.lat}
    data-lng={punto.lng}
    data-aprox={hayPunto ? '1' : '0'}
    role="img"
    aria-label={`${t('map.aprox')}${zona ? ` — ${zona}` : ''}`}
  >
  </div>
  <div class="pie">
    <p class="nota">
      📍 {t('map.aprox')}{zona ? ` — ${zona}` : ''}. {t('map.nota')}
    </p>
    <a class="btn btn--ghost gmaps" href={googleMaps} target="_blank" rel="noopener">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" />
      </svg>
      {t('map.google')}
    </a>
  </div>
</div>

<!-- Leaflet + OpenStreetMap : gratuit, sin clave API ni tarjeta -->
<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>

<style>
  .mapa-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  #mapa {
    height: 340px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--violet-soft);
    z-index: 0;
  }
  .pie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem 1.2rem;
    flex-wrap: wrap;
  }
  .nota {
    margin: 0;
    flex: 1 1 280px;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .gmaps {
    padding: 0.55rem 0.9rem;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  /* Boutons de zoom aux couleurs du site : carrés, violets */
  #mapa :global(.leaflet-bar) {
    border: 0;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(62, 0, 85, 0.25);
  }
  #mapa :global(.leaflet-bar a) {
    width: 32px;
    height: 32px;
    line-height: 30px;
    background: var(--violet);
    color: #fff;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
  }
  #mapa :global(.leaflet-bar a:last-child) {
    border-bottom: 0;
  }
  #mapa :global(.leaflet-bar a:hover) {
    background: var(--violet-700);
    color: #fff;
  }
  #mapa :global(.leaflet-bar a.leaflet-disabled) {
    background: #c8bccd;
    color: #fff;
  }
</style>

<script>
  // @ts-nocheck
  function initMapa() {
    const el = document.getElementById('mapa');
    if (!el || el.dataset.ready) return;
    el.dataset.ready = '1';

    const lat = parseFloat(el.dataset.lat);
    const lng = parseFloat(el.dataset.lng);
    const aprox = el.dataset.aprox === '1';

    const map = L.map(el, { scrollWheelZoom: false, zoomControl: true }).setView(
      [lat, lng],
      aprox ? 15 : 12
    );

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap',
      maxZoom: 19,
    }).addTo(map);

    // La carte peut être créée avant que la page ait fini sa mise en page
    // (police, galerie, feuille de style Leaflet) : Leaflet ne charge alors
    // qu'une partie des tuiles. On lui redonne sa taille réelle dès qu'elle
    // change, et une fois la page entièrement chargée.
    const recalcular = () => map.invalidateSize();
    if ('ResizeObserver' in window) new ResizeObserver(recalcular).observe(el);
    window.addEventListener('load', recalcular);
    setTimeout(recalcular, 400);

    // Cercle "approximatif" plutôt qu'un pin précis : signature visuelle
    // + confidentialité de l'adresse exacte.
    if (aprox) {
      L.circle([lat, lng], {
        radius: 320,
        color: '#3e0055',
        weight: 2,
        fillColor: '#3e0055',
        fillOpacity: 0.14,
      }).addTo(map);
    }
  }

  function loadLeaflet() {
    if (window.L) return initMapa();
    const s = document.createElement('script');
    s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
    s.integrity = 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=';
    s.crossOrigin = '';
    s.onload = initMapa;
    document.head.appendChild(s);
  }

  loadLeaflet();
  document.addEventListener('astro:after-swap', () => {
    delete document.getElementById('mapa')?.dataset.ready;
    loadLeaflet();
  });
</script>
