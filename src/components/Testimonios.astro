---
import type { CollectionEntry } from 'astro:content';
import { site } from '../lib/site';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));

interface Props {
  resenas: CollectionEntry<'resenas'>[];
}
const { resenas } = Astro.props;
---

<div class="testimonios">
  {
    resenas.map((r) => (
      <figure class="testi">
        <div class="estrellas" aria-label={`${r.data.estrellas} de 5`}>
          {Array.from({ length: 5 }).map((_, i) => (
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill={i < r.data.estrellas ? 'currentColor' : 'none'}
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.7L12 17.8 5.9 20.3l1.4-6.7L2.2 9l6.9-.7z" />
            </svg>
          ))}
        </div>
        <blockquote>{r.data.texto}</blockquote>
        <figcaption>
          <span class="nombre">{r.data.nombre}</span>
          {r.data.contexto && <span class="contexto">{r.data.contexto}</span>}
        </figcaption>
      </figure>
    ))
  }
</div>

{
  (site.googleResenas || site.googleEscribir) && (
    <div class="google">
      <span class="g-logo" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 48 48">
          <path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.6 5.4 2.7 13.3l7.9 6.1C12.5 13.6 17.8 9.5 24 9.5z" />
          <path fill="#4285F4" d="M46.1 24.6c0-1.6-.1-3.1-.4-4.6H24v9h12.4c-.5 2.9-2.2 5.3-4.6 6.9l7.4 5.7c4.3-4 6.9-9.9 6.9-17z" />
          <path fill="#FBBC05" d="M10.6 28.6c-.5-1.4-.8-3-.8-4.6s.3-3.2.8-4.6l-7.9-6.1C1 16.6 0 20.2 0 24s1 7.4 2.7 10.7l7.9-6.1z" />
          <path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.4-5.7c-2.1 1.4-4.8 2.3-8.5 2.3-6.2 0-11.5-4.1-13.4-9.9l-7.9 6.1C6.6 42.6 14.6 48 24 48z" />
        </svg>
      </span>
      <div class="g-botones">
        {site.googleResenas && (
          <a class="btn btn--ghost" href={site.googleResenas} target="_blank" rel="noopener">
            {t('res.google_ver')}
          </a>
        )}
        {site.googleEscribir && (
          <a class="btn btn--primary" href={site.googleEscribir} target="_blank" rel="noopener">
            {t('res.google_escribir')}
          </a>
        )}
      </div>
    </div>
  )
}

<style>
  .google {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.8rem 1rem;
    margin-top: 2rem;
  }
  .g-logo {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 50%;
  }
  .g-botones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
  }
  .testimonios {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: clamp(1.2rem, 3vw, 1.8rem);
  }
  .testi {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 4px solid var(--violet); /* liseré violet, comme les « tarjetas » du logiciel */
    border-radius: var(--radius);
    padding: 1.6rem;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .estrellas {
    display: flex;
    gap: 2px;
    color: var(--violet);
  }
  blockquote {
    margin: 0;
    font-family: var(--display);
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--ink);
    font-weight: 400;
  }
  blockquote::before {
    content: '“';
    color: var(--violet);
  }
  blockquote::after {
    content: '”';
    color: var(--violet);
  }
  figcaption {
    display: flex;
    flex-direction: column;
    margin-top: auto;
    padding-top: 0.5rem;
    border-top: 1px solid var(--line);
  }
  .nombre {
    font-weight: 700;
    font-size: 0.95rem;
  }
  .contexto {
    font-size: 0.83rem;
    color: var(--muted);
  }
</style>
