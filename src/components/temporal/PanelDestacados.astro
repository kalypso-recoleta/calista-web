---
/**
 * Bande « Destacados » sous les filtres des pages de listes : annonces cochées
 * « panel lateral » dans l'admin, de la même rubrique. Une seule ligne : on en
 * montre autant que la largeur le permet, centrées. Rien si aucune n'est cochée.
 */
import { img } from '../../lib/cloudinary';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';
import { slugTemporal, reservasJson, precioTxt, LOCALE, bienesLaterales, temporalesLaterales, tarifasDe, type Rubrica } from './datos';
import { slugify } from '../../lib/slug';
import { formatPrecio, operacionLabel, estadoLabel } from '../../lib/format';

interface Props {
  rubrica: Rubrica; // chaque page ne montre que les annonces de sa rubrique
}
const { rubrica } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const L = (p: string) => localizePath(p, lang);
const loc = LOCALE[lang];
const items = await temporalesLaterales(rubrica);
const bienes = await bienesLaterales(rubrica);
const textos = { disponible: t('temp.disponible'), alquilado: t('temp.alquilado'), libre: t('temp.libre_desde'), locale: loc };
---

{
  (items.length > 0 || bienes.length > 0) && (
    <aside class="panel" data-panel-destacados data-textos={JSON.stringify(textos)}>
      <p class="panel-tit">★ {t('temp.destacados')}</p>
      <div class="panel-fila">
      {bienes.map((b) => {
        const d = b.data;
        return (
          <a class="pcard" href={L(`/propiedad/${slugify(b.id)}`)}>
            <div class="pmedia">
              <img src={img(d.portada_foto || d.imagenes[0], { w: 520, h: 340 })} alt={d.titulo} width="520" height="340" loading="lazy" />
              <span class="pestado es-op">{d.estado === 'reservado' ? estadoLabel(d.estado, lang) : operacionLabel(d.operacion, lang)}</span>
            </div>
            <div class="pbody">
              <p class="ptitulo">{d.titulo}</p>
              <p class="pprecio"><strong>{formatPrecio(d, lang)}</strong></p>
            </div>
          </a>
        );
      })}
      {items.map((it) => {
        const d = it.data;
        const r = tarifasDe(it)[0];
        return (
          <a class="pcard" href={L(`/alquiler-temporal/${slugTemporal(it)}`)} data-reservas={reservasJson(it)}>
            <div class="pmedia">
              <img src={img(d.portada_foto || d.imagenes[0], { w: 520, h: 340 })} alt={d.titulo} width="520" height="340" loading="lazy" />
              <span class="pestado" data-estado hidden />
            </div>
            <div class="pbody">
              {d.gama === 'kalypso' && (
                <p class="pgama">{t('temp.kalypso_badge')}{d.residencia ? ` · ${d.residencia}` : ''}</p>
              )}
              <p class="ptitulo">{d.titulo}</p>
              <p class="pprecio">
                {r ? <>{t('tar.desde')} <strong>{precioTxt(r.precio, d.moneda, loc)}</strong> {t(`tar.u_${r.unidad}`)}</> : t('tar.consultar')}
              </p>
            </div>
          </a>
        );
      })}
      </div>
    </aside>
  )
}

<script>
  import { leerRangos, estadoHoy, fechaCorta } from '../../lib/temporal';
  document.querySelectorAll<HTMLElement>('[data-panel-destacados]').forEach((panel) => {
    const tx = JSON.parse(panel.dataset.textos || '{}');
    panel.querySelectorAll<HTMLElement>('[data-reservas]').forEach((card) => {
      const e = estadoHoy(leerRangos(card.dataset.reservas));
      const b = card.querySelector<HTMLElement>('[data-estado]');
      if (!b) return;
      b.textContent = e.alquilado ? `${tx.alquilado} · ${tx.libre} ${fechaCorta(e.libre!, tx.locale)}` : tx.disponible;
      b.classList.add(e.alquilado ? 'es-alquilado' : 'es-libre');
      b.hidden = false;
    });
  });
</script>

<style>
  [hidden] { display: none !important; }
  .panel {
    margin: 0 0 1.6rem; padding: 1.1rem 1.3rem 1.3rem; background: #fff; border: 1px solid var(--line);
    border-top: 4px solid var(--violet); border-radius: var(--radius); box-shadow: var(--shadow);
  }
  /* Une seule ligne de vignettes, centrée : les vignettes qui ne tiennent pas
     passent sur des lignes de hauteur 0, masquées. */
  .panel-fila {
    display: grid; margin-top: 0.9rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 260px));
    grid-template-rows: auto; grid-auto-rows: 0;
    justify-content: center; column-gap: 1.1rem; row-gap: 0; overflow: hidden;
  }
  .panel-tit { margin: 0; font-weight: 700; color: var(--violet); text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.82rem; }
  .panel-sub { margin: -0.6rem 0 0; font-size: 0.85rem; color: var(--muted); }
  .pcard { display: block; color: var(--ink); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .pcard:hover { text-decoration: none; border-color: var(--violet); }
  .pmedia { position: relative; aspect-ratio: 16 / 10; background: var(--violet-soft); }
  .pmedia img { width: 100%; height: 100%; object-fit: cover; }
  .pestado { position: absolute; top: 0.5rem; left: 0.5rem; padding: 0.2rem 0.55rem; border-radius: 20px; font-size: 0.7rem; font-weight: 700; background: #fff; }
  .pestado.es-libre { color: var(--ok); }
  .pestado.es-alquilado { background: var(--brand); color: #fff; }
  .pestado.es-op { color: var(--ink); }
  .pgama--temp { color: var(--muted); }
  .pbody { background: var(--card-tint); padding: 0.7rem 0.8rem 0.8rem; display: flex; flex-direction: column; gap: 0.2rem; }
  .pgama { margin: 0; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--violet); }
  .ptitulo { margin: 0; font-weight: 600; font-size: 0.95rem; line-height: 1.3; }
  .pprecio { margin: 0; font-size: 0.85rem; color: var(--muted); }
  .pprecio strong { color: var(--brand); }
  .panel-mas { font-weight: 700; font-size: 0.88rem; color: var(--violet); }
</style>
