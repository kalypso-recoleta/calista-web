---
import { existsSync } from 'node:fs';
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';
import { temporalesActivos, LOCALE } from './datos';
import TarjetaTemporal from './TarjetaTemporal.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const L = (p: string) => localizePath(p, lang);
const loc = LOCALE[lang];
// modo « inicio » : page d'accueil Alquiler temporal (les deux expériences + destacados) ;
// « kalypso » : page Residencias Kalypso ; « otros » : page Otros departamentos amoblados.
const { modo = 'inicio' } = Astro.props as { modo?: 'inicio' | 'kalypso' | 'otros' };
const esKalypso = modo === 'kalypso';
const esInicio = modo === 'inicio';
const items = await temporalesActivos();
// Destacados : sous les deux expériences (page d'accueil seulement), plus de panneau à droite
const destacados = !esInicio ? [] : items.filter((i) => i.data.destacado);
const kalypsos = items.filter((i) => i.data.gama === 'kalypso');
const lista = esKalypso ? kalypsos : items.filter((i) => i.data.gama !== 'kalypso');
const tituloPagina = esKalypso ? t('temp.kalypso_title') : modo === 'otros' ? t('temp.otros_title') : '';
// Logo Kalypso : affiché au-dessus de « Residencias Kalypso » dès que le fichier
// public/logo-kalypso.png (ou .svg) est présent dans le dépôt.
const logoKalypso = ['svg', 'png', 'webp'].map((e) => `/logo-kalypso.${e}`).find((p) => existsSync(`public${p}`));
const textos = {
  disponible: t('temp.disponible'),
  alquilado: t('temp.alquilado'),
  libre: t('temp.libre_desde'),
  locale: loc,
};
---

<Layout title={tituloPagina ? `${tituloPagina} — ${t('temp.title')}` : t('temp.title')} description={esKalypso ? t('temp.kalypso_intro') : modo === 'otros' ? t('temp.otros_intro') : t('temp.intro')}>
  <section class="section">
    <div class="container">
      {!esInicio && (
        <nav class="crumbs" aria-label="•">
          <a href={L('/')}>{t('det.inicio')}</a><span>/</span>
          <a href={L('/alquiler-temporal')}>{t('temp.title')}</a><span>/</span>
          <span>{tituloPagina}</span>
        </nav>
      )}
      {modo === 'otros' && (
        <header class="cab">
          <p class="eyebrow">{t('temp.eyebrow')}</p>
          <h1>{t('temp.otros_title')}</h1>
          <p class="lead">{t('temp.otros_intro')}</p>
        </header>
      )}
      {esKalypso && (
        <>
        <!-- Présentation de la gamme Residencias Kalypso (uniquement sur sa page) -->
        <section class="kalypso-intro">
          {logoKalypso && <img class="ki-logo" src={logoKalypso} alt="Kalypso" width="160" />}
          <div class="ki-texto">
            <p class="eyebrow">{t('temp.kalypso_title')}</p>
            <h1>{t('temp.kalypso_tag')}</h1>
            {[1, 2, 3, 4].map((n) => <p>{t(`temp.kalypso_p${n}`)}</p>)}
          </div>
        </section>
        </>
      )}
      {esInicio && (
        <>
          <header class="cab">
            <p class="eyebrow">{t('temp.eyebrow')}</p>
            <h1>{t('temp.title')}</h1>
            <p class="lead">{t('temp.intro')}</p>
          </header>
          <!-- Les deux expériences -->
          <div class="experiencias">
            <a class="exp exp--kalypso" href={L('/alquiler-temporal/residencias-kalypso')}>
              {logoKalypso && <img class="exp-logo" src={logoKalypso} alt="" width="110" />}
              <div>
                <h2>{t('temp.kalypso_title')}</h2>
                <p>{t('temp.kalypso_intro')}</p>
                <span class="exp-cta">{t('temp.kalypso_cta')} →</span>
              </div>
            </a>
            <a class="exp exp--otros" href={L('/alquiler-temporal/otros-departamentos')}>
              <div>
                <h2>{t('temp.otros_title')}</h2>
                <p>{t('temp.otros_intro')}</p>
                <span class="exp-cta">{t('temp.otros_cta')} →</span>
              </div>
            </a>
          </div>
          {destacados.length > 0 && (
            <section class="destacados">
              <header class="grupo-cab"><h2>★ {t('temp.destacados')}</h2></header>
              <div class="grid-biens" data-temporales data-textos={JSON.stringify(textos)}>
                {destacados.map((it) => <TarjetaTemporal it={it} />)}
              </div>
            </section>
          )}
        </>
      )}

      {!esInicio && (
      <section class="principal">
        {esKalypso && <header class="grupo-cab"><h2>{t('temp.kalypso_lista')}</h2></header>}
        {lista.length === 0 && <p class="vacio">{esKalypso ? t('temp.kalypso_vacio') : t('temp.otros_vacio')}</p>}
        <div class="grid-biens" data-temporales data-textos={JSON.stringify(textos)}>
          {lista.map((it) => <TarjetaTemporal it={it} />)}
        </div>
      </section>
      )}
      <p class="cond">{t('temp.condiciones')}</p>
    </div>
  </section>
</Layout>

<script>
  import { leerRangos, estadoHoy, fechaCorta } from '../../lib/temporal';
  // L'état (Disponible / Alquilado) se calcule ici, à la date du jour du visiteur :
  // il reste juste sans republier le site.
  document.querySelectorAll<HTMLElement>('[data-temporales]').forEach((grid) => {
    const tx = JSON.parse(grid.dataset.textos || '{}');
    grid.querySelectorAll<HTMLElement>('[data-reservas]').forEach((card) => {
      const e = estadoHoy(leerRangos(card.dataset.reservas));
      const badge = card.querySelector<HTMLElement>('[data-estado]');
      if (!badge) return;
      badge.textContent = e.alquilado
        ? `${tx.alquilado} · ${tx.libre} ${fechaCorta(e.libre!, tx.locale)}`
        : tx.disponible;
      badge.classList.add(e.alquilado ? 'es-alquilado' : 'es-libre');
      badge.hidden = false;
    });
  });
</script>

<style>
  [hidden] { display: none !important; }
  .cab { max-width: 62ch; margin-bottom: 2rem; }
  .cab h1 { margin-bottom: 0.4rem; }
  .grid-biens { grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
  .crumbs { display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: 0.85rem; color: var(--muted); margin-bottom: 1.2rem; }
  .crumbs a { color: var(--muted); }
  .ki-texto h1 { margin: 0 0 1rem; font-size: clamp(1.5rem, 2.6vw, 2rem); }
  /* Les deux expériences, côte à côte */
  .destacados { margin: 0 0 3.5rem; }
  .experiencias { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin: 0.5rem 0 3.5rem; }
  .exp {
    display: flex; align-items: center; gap: 1.6rem; padding: 2rem 2.2rem; color: var(--ink);
    background: #fff; border: 1px solid var(--line); border-top: 4px solid var(--violet);
    border-radius: var(--radius); box-shadow: var(--shadow);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .exp:hover { text-decoration: none; box-shadow: var(--shadow-lg); }
  .exp h2 { margin: 0 0 0.5rem; font-size: clamp(1.35rem, 2.2vw, 1.7rem); }
  .exp p { margin: 0 0 0.9rem; color: var(--muted); line-height: 1.55; }
  .exp-logo { width: 120px; height: auto; flex: none; }
  .exp-cta { font-weight: 700; color: var(--violet); }
  @media (max-width: 760px) {
    .experiencias { grid-template-columns: 1fr; }
    .exp { padding: 1.4rem; gap: 1rem; }
    .exp-logo { width: 80px; }
  }
  .kalypso-intro {
    display: grid; grid-template-columns: 170px 1fr; gap: 2rem; align-items: start;
    margin: 0 0 3rem; padding: 2rem 2.2rem; background: #fff;
    border: 1px solid var(--line); border-left: 4px solid var(--violet); border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .ki-logo { width: 160px; height: auto; }
  .ki-texto { max-width: 70ch; }
  .ki-texto h2 { margin: 0 0 1rem; font-size: clamp(1.35rem, 2.2vw, 1.75rem); }
  .ki-texto p:not(.eyebrow) { color: var(--ink); line-height: 1.7; margin: 0 0 0.8rem; }
  .ki-texto p:last-child { margin-bottom: 0; }
  @media (max-width: 760px) {
    .kalypso-intro { grid-template-columns: 1fr; padding: 1.4rem; gap: 1rem; }
    .ki-logo { width: 120px; }
  }
  .grupo-logo { display: block; height: 68px; width: auto; margin-bottom: 0.6rem; }
  .con-panel { display: grid; grid-template-columns: minmax(0, 1fr) 290px; gap: 2rem; align-items: start; }
  @media (max-width: 1000px) { .con-panel { grid-template-columns: 1fr; } }
  .vacio { margin: 0; padding: 1.2rem 1.4rem; background: #fff; border: 1px dashed var(--line); border-radius: var(--radius); color: var(--muted); }
  .grupo-cab { align-self: end; margin-bottom: 1.3rem; padding-left: 0.9rem; border-left: 4px solid var(--violet); }
  .grupo-cab h2 { margin: 0 0 0.2rem; }
  .grupo-cab p { margin: 0; color: var(--muted); }
  .cond { margin-top: 2rem; color: var(--muted); font-size: 0.9rem; }
</style>
