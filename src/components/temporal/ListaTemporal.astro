---
import Layout from '../../layouts/Layout.astro';
import { img } from '../../lib/cloudinary';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';
import { temporalesActivos, slugTemporal, reservasJson, precioTxt, LOCALE } from './datos';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const L = (p: string) => localizePath(p, lang);
const loc = LOCALE[lang];
const items = await temporalesActivos();
const textos = {
  disponible: t('temp.disponible'),
  alquilado: t('temp.alquilado'),
  libre: t('temp.libre_desde'),
  locale: loc,
};
---

<Layout title={t('temp.title')} description={t('temp.intro')}>
  <section class="section">
    <div class="container">
      <header class="cab">
        <p class="eyebrow">{t('temp.eyebrow')}</p>
        <h1>{t('temp.title')}</h1>
        <p class="lead">{t('temp.intro')}</p>
      </header>

      {
        items.length === 0 ? (
          <p class="lead">{t('temp.vacia')}</p>
        ) : (
          <div class="grid-biens" data-temporales data-textos={JSON.stringify(textos)}>
            {items.map((it) => {
              const d = it.data;
              const foto = d.portada_foto || d.imagenes[0];
              const semana = precioTxt(d.precio_semana, d.moneda, loc);
              const mes = precioTxt(d.precio_mes, d.moneda, loc);
              return (
                <a class="tcard" href={L(`/alquiler-temporal/${slugTemporal(it)}`)} data-reservas={reservasJson(it)}>
                  <div class="media">
                    <img src={img(foto, { w: 640, h: 440 })} alt={d.titulo} width="640" height="440" loading="lazy" />
                    <span class="estado" data-estado hidden />
                  </div>
                  <div class="body">
                    <p class="loc">{[d.barrio, d.ciudad].filter(Boolean).join(', ')}</p>
                    <h2 class="titulo">{d.titulo}</h2>
                    <p class="specs">
                      {[
                        d.dormitorios != null && `${d.dormitorios} ${t('spec.dorm')}`,
                        d.banos != null && `${d.banos} ${t('spec.banos')}`,
                        d.huespedes != null && `${d.huespedes} ${t('temp.huespedes').toLowerCase()}`,
                        d.superficie != null && `${d.superficie} m²`,
                      ]
                        .filter(Boolean)
                        .join(' · ')}
                    </p>
                    <div class="precios">
                      {semana && <span><strong>{semana}</strong> {t('temp.semana')}</span>}
                      {mes && <span><strong>{mes}</strong> {t('temp.mes')}</span>}
                    </div>
                    <span class="ver">{t('temp.ver')} →</span>
                  </div>
                </a>
              );
            })}
          </div>
        )
      }
      <p class="cond">{t('temp.condiciones')}</p>
    </div>
  </section>
</Layout>

<script>
  import { leerRangos, estadoHoy, fechaCorta } from '../../lib/temporal';
  // L'état (Disponible / Alquilado) se calcule ici, à la date du jour du visiteur :
  // il reste juste sans republier le site.
  document.querySelectorAll<HTMLElement>('[data-temporales]').forEach((grid) => {
    const tx = JSON.parse(grid.dataset.textos || '{}');
    grid.querySelectorAll<HTMLElement>('[data-reservas]').forEach((card) => {
      const e = estadoHoy(leerRangos(card.dataset.reservas));
      const badge = card.querySelector<HTMLElement>('[data-estado]');
      if (!badge) return;
      badge.textContent = e.alquilado
        ? `${tx.alquilado} · ${tx.libre} ${fechaCorta(e.libre!, tx.locale)}`
        : tx.disponible;
      badge.classList.add(e.alquilado ? 'es-alquilado' : 'es-libre');
      badge.hidden = false;
    });
  });
</script>

<style>
  [hidden] { display: none !important; }
  .cab { max-width: 62ch; margin-bottom: 2rem; }
  .cab h1 { margin-bottom: 0.4rem; }
  .tcard {
    display: flex; flex-direction: column; height: 100%;
    background: var(--surface); border: 1px solid var(--line);
    border-top: 4px solid var(--violet); border-radius: var(--radius);
    overflow: hidden; box-shadow: var(--shadow); color: var(--ink);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .tcard:hover { text-decoration: none; transform: translateY(-3px); box-shadow: var(--shadow-lg); }
  .media { position: relative; aspect-ratio: 16 / 11; background: var(--violet-soft); }
  .media img { width: 100%; height: 100%; object-fit: cover; }
  .estado {
    position: absolute; top: 0.8rem; left: 0.8rem; padding: 0.3rem 0.7rem;
    border-radius: 20px; font-size: 0.78rem; font-weight: 700; background: #fff;
  }
  .estado.es-libre { color: var(--ok); }
  .estado.es-alquilado { background: var(--brand); color: #fff; }
  .body { padding: 1.1rem 1.2rem 1.3rem; display: flex; flex-direction: column; gap: 0.35rem; flex: 1; }
  .loc { margin: 0; font-size: 0.82rem; color: var(--muted); }
  .titulo { margin: 0; font-size: 1.1rem; line-height: 1.3; }
  .specs { margin: 0; font-size: 0.88rem; color: var(--muted); }
  .precios { display: flex; flex-wrap: wrap; gap: 0.2rem 1rem; margin-top: 0.4rem; color: var(--muted); font-size: 0.9rem; }
  .precios strong { color: var(--brand); font-size: 1.05rem; }
  .ver { margin-top: auto; padding-top: 0.6rem; font-weight: 700; font-size: 0.88rem; color: var(--violet); }
  .cond { margin-top: 2rem; color: var(--muted); font-size: 0.9rem; }
</style>
