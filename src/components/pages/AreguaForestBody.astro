---
/**
 * Page de vente Areguá Forest (/terrenos/aregua-forest).
 * Textes dans src/components/aregua/textos.ts (4 langues).
 * Photos : /uploads/aregua-forest-*.jpg — 11 à 14 sont des photos réelles du terrain,
 * les autres des images de synthèse du développeur (signalées « ilustrativa »).
 */
import Layout from '../../layouts/Layout.astro';
import { textos, grilla } from '../aregua/textos';
import { whatsappLink } from '../../lib/whatsapp';
import { site } from '../../lib/site';
import { img } from '../../lib/cloudinary';
import { getLangFromUrl, localizePath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const c = textos[lang] ?? textos.es;
const L = (p: string) => localizePath(p, lang);
// Message pré-rempli dans la langue du visiteur
const wa = whatsappLink(c.wa_msg);
const waCasa = whatsappLink(c.casa_msg);
const ficha = L('/propiedad/terrenos-en-barrio-cerrado-aregua-forest-desde-360-m');
const mapa = 'https://maps.app.goo.gl/jKm8qMHhwfoQW7U79';
const hero = '/uploads/aregua-forest-02.jpg';
const unescoUrl = 'https://www.unesco.org/en/creative-cities/aregua';
---

<Layout title={c.seo_t} description={c.seo_d} image={hero} tituloCompleto>
  <!-- Hero -->
  <section class="hero">
    <img class="hero-img" src={img(hero, { w: 1800, h: 900 })} alt={c.ilus} width="1800" height="900" loading="eager" />
    <div class="hero-velo"></div>
    <div class="container hero-txt">
      <p class="eyebrow claro">{c.eyebrow}</p>
      <h1>Areguá Forest</h1>
      <p class="hero-lema">{c.lema}</p>
      <p class="hero-d">{c.hero_d}</p>
      <div class="acciones">
        <a class="btn btn--wa" href={wa} target="_blank" rel="noopener">{c.wa_btn}</a>
        <a class="btn btn--ghost" href={ficha}>{c.ficha_btn}</a>
      </div>
    </div>
    <span class="nota-img">{c.ilus}</span>
  </section>

  <!-- Chiffres clés -->
  <section class="container">
    <ul class="stats">
      {c.stats.map(([n, d]) => (<li><strong>{n}</strong><span>{d}</span></li>))}
    </ul>
    <a class="unesco" href={unescoUrl} target="_blank" rel="noopener">
      <span class="sello">UNESCO</span>
      <span><strong>{c.unesco}</strong><small>{c.unesco_d}</small></span>
    </a>
  </section>

  <!-- Vivre dans la forêt -->
  <section class="section">
    <div class="container dos vivir">
      <div>
        <p class="eyebrow">{c.vivir_eyebrow}</p>
        <h2>{c.vivir_t}</h2>
        {c.vivir_p.map((p) => <p>{p}</p>)}
      </div>
      <div class="fotos-reales">
        {['/uploads/aregua-forest-11.jpg', '/uploads/aregua-forest-12.jpg'].map((f) => (
          <figure>
            <img src={img(f, { w: 600, h: 750 })} alt={c.real} width="600" height="750" loading="lazy" />
            <figcaption>{c.real}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Équipements -->
  <section class="section fondo">
    <div class="container">
      <p class="eyebrow">{c.amen_eyebrow}</p>
      <h2>{c.amen_t}</h2>
      <div class="galeria">
        {c.amen_fotos.map(([f, t]) => (
          <figure>
            <img src={img(f, { w: 700, h: 500 })} alt={t} width="700" height="500" loading="lazy" />
            <figcaption><strong>{t}</strong><small>{c.ilus}</small></figcaption>
          </figure>
        ))}
      </div>
      <ul class="amen">{c.amen.map((a) => <li>{a}</li>)}</ul>
    </div>
  </section>

  <!-- Situation + étapes -->
  <section class="section">
    <div class="container dos">
      <div>
        <p class="eyebrow">{c.ubi_eyebrow}</p>
        <h2>{c.ubi_t}</h2>
        <ul class="dist">{c.ubi.map(([l, d]) => <li><span>{l}</span><strong>{d}</strong></li>)}</ul>
        <a class="btn btn--ghost" href={mapa} target="_blank" rel="noopener">📍 {c.mapa}</a>
        <p class="tip">{c.etapas_tip}</p>
      </div>
      <div>
        <p class="eyebrow">{c.etapas_eyebrow}</p>
        <h2>{c.etapas_t}</h2>
        <p>{c.etapas_d}</p>
        <ol class="etapas">{c.etapas.map(([e, f]) => <li><strong>{e}</strong><span>{f}</span></li>)}</ol>
      </div>
    </div>
  </section>

  <!-- Grille de prix -->
  <section class="section fondo">
    <div class="container">
      <p class="eyebrow">{c.tabla_eyebrow}</p>
      <h2>{c.tabla_t}</h2>
      <p>{c.tabla_d}</p>
      <div class="tabla-wrap">
        <table class="tabla">
          <thead><tr>{c.tabla_cols.map((h) => <th>{h}</th>)}</tr></thead>
          <tbody>
            {grilla.map((g) => (
              <tr class:list={{ promo: g.etapa === 5 }}>
                <td><strong>{c.tabla_cols[0]} {g.etapa}</strong></td>
                <td>{g.entrega[lang] ?? g.entrega.es}</td>
                <td>USD {g.contado[0]} / {g.contado[1]}{c.tabla_m2}</td>
                <td>USD {g.financiado[0]} / {g.financiado[1]}{c.tabla_m2}</td>
                <td>{g.disponibles}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="sim" data-sim>
        <div class="sim-in">
          <h3>{c.sim_t}</h3>
          <p>{c.sim_d}</p>
          <label>{c.sim_etapa}
            <select data-etapa>
              {grilla.map((g) => <option value={g.etapa} selected={g.etapa === 5}>{c.sim_etapa} {g.etapa} · {g.entrega[lang] ?? g.entrega.es}</option>)}
            </select>
          </label>
          <fieldset>
            <legend>{c.sim_ubic}</legend>
            <label class="radio"><input type="radio" name="ubic" value="0" checked /> {c.sim_central}</label>
            <label class="radio"><input type="radio" name="ubic" value="1" /> {c.sim_esquina}</label>
          </fieldset>
          <label>{c.sim_sup}: <strong data-sup-txt>370 m²</strong>
            <input type="range" min="369.6" max="372.07" step="0.01" value="369.6" data-sup />
            <small class="rango" data-sup-rango></small>
          </label>
        </div>
        <div class="sim-out" aria-live="polite">
          <div class="big"><span>{c.sim_contado}</span><strong data-contado>—</strong></div>
          <div><span>{c.sim_fin}</span><strong data-fin>—</strong></div>
          <div><span>{c.sim_entrega}</span><strong data-entrega>—</strong></div>
          <div><span>{c.sim_cuota}</span><strong data-cuota>—</strong></div>
          <div><span>{c.sim_entr}</span><strong data-entr>—</strong></div>
          <a class="btn btn--wa" data-wa href={wa} target="_blank" rel="noopener">{c.sim_btn}</a>
          <small>{c.sim_aviso}</small>
        </div>
      </div>
    </div>
  </section>

  <!-- Investissement + maison -->
  <section class="section">
    <div class="container dos">
      <div class="tarjeta">
        <p class="eyebrow">{c.inv_eyebrow}</p>
        <h3>{c.inv_t}</h3>
        <div class="barras" aria-hidden="true">
          <div><span style="height:60%"></span><small>USD 60/m²</small></div>
          <div><span style="height:100%"></span><small>USD 100/m²</small></div>
        </div>
        <p>{c.inv_d}</p>
        <p class="nota">{c.inv_nota}</p>
      </div>
      <div class="tarjeta casa">
        <p class="eyebrow">{c.casa_eyebrow}</p>
        <h3>{c.casa_t}</h3>
        <p>{c.casa_d}</p>
        <a class="btn btn--primary" href={waCasa} target="_blank" rel="noopener">{c.casa_btn}</a>
        <figure class="casa-img">
          <img src={img('/uploads/aregua-forest-01.jpg', { w: 900, h: 560 })} alt={c.ilus} width="900" height="560" loading="lazy" />
          <figcaption>{c.ilus}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Pourquoi CALISTA -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">{c.cal_eyebrow}</p>
      <h2>{c.cal_t}</h2>
      <div class="cal">
        {c.cal.map(([t, d], i) => (
          <div><span class="num">{i + 1}</span><h3>{t}</h3><p>{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section fondo">
    <div class="container faq">
      <h2>{c.faq_t}</h2>
      {c.faq.map(([q, r]) => (
        <details><summary>{q}</summary><p>{r}</p></details>
      ))}
    </div>
  </section>

  <!-- Appel final -->
  <section class="section">
    <div class="container final">
      <h2>{c.fin_t}</h2>
      <p>{c.fin_d}</p>
      <a class="btn btn--wa" href={wa} target="_blank" rel="noopener">{c.wa_btn}</a>
      <p class="fuente">{c.fuente}</p>
    </div>
  </section>
</Layout>

<script
  is:inline
  define:vars={{
    G: grilla.map((g) => ({ etapa: g.etapa, contado: g.contado, fin: g.financiado, sup: g.sup, entrega: g.entrega[lang] ?? g.entrega.es })),
    T: { etapa: c.sim_etapa, ubic: [c.sim_central, c.sim_esquina], wa: c.sim_wa, num: site.whatsapp },
    LOC: { es: 'es-PY', fr: 'fr-FR', en: 'en-US', pt: 'pt-BR' }[lang],
  }}
>
  document.querySelectorAll('[data-sim]').forEach((el) => {
    const $ = (s) => el.querySelector(s);
    const usd = (n) => 'USD ' + Math.round(n).toLocaleString(LOC);
    const m2 = (n) => n.toLocaleString(LOC, { maximumFractionDigits: 2 });
    let clave = '';
    const calc = () => {
      const g = G.find((x) => x.etapa === +$('[data-etapa]').value);
      const u = +el.querySelector('input[name="ubic"]:checked').value;
      const r = $('[data-sup]');
      // Curseur borné aux surfaces des lots disponibles de l'étape et de l'emplacement choisis
      if (clave !== g.etapa + '-' + u) {
        clave = g.etapa + '-' + u;
        r.min = g.sup[u][0]; r.max = g.sup[u][1];
        r.value = g.sup[u][0];
        $('[data-sup-rango]').textContent = m2(g.sup[u][0]) + ' – ' + m2(g.sup[u][1]) + ' m²';
      }
      const sup = +r.value;
      const contado = sup * g.contado[u];
      const fin = sup * g.fin[u];
      $('[data-sup-txt]').textContent = m2(sup) + ' m²';
      $('[data-contado]').textContent = usd(contado);
      $('[data-fin]').textContent = usd(fin);
      $('[data-entrega]').textContent = usd(fin * 0.2);
      $('[data-cuota]').textContent = usd((fin * 0.8) / 36);
      $('[data-entr]').textContent = g.entrega;
      const msg = T.wa.replace('{etapa}', T.etapa + ' ' + g.etapa).replace('{ubic}', T.ubic[u]).replace('{sup}', m2(sup)).replace('{contado}', usd(contado));
      $('[data-wa]').href = 'https://wa.me/' + T.num + '?text=' + encodeURIComponent(msg);
    };
    el.addEventListener('input', calc);
    el.addEventListener('change', calc);
    calc();
  });
</script>

<style>
  .hero { position: relative; min-height: min(78vh, 640px); display: flex; align-items: flex-end; overflow: hidden; color: #fff; }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-velo { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(33, 43, 53, 0.1) 0%, rgba(33, 43, 53, 0.35) 45%, rgba(62, 0, 85, 0.85) 100%); }
  .hero-txt { position: relative; padding-block: 3rem 3.5rem; }
  .hero h1 { font-size: clamp(2.4rem, 6vw, 4rem); margin: 0 0 0.4rem; color: #fff; }
  .claro { color: var(--violet-light); }
  .hero-lema { font-size: clamp(1.15rem, 2.2vw, 1.45rem); font-weight: 600; margin: 0 0 0.6rem; max-width: 38ch; }
  .hero-d { max-width: 60ch; opacity: 0.92; }
  .acciones { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.4rem; }
  .nota-img { position: absolute; right: 0.8rem; top: 0.8rem; font-size: 0.75rem; background: rgba(0, 0, 0, 0.45); padding: 0.2rem 0.55rem; border-radius: var(--radius); }

  .stats { list-style: none; margin: -2rem 0 0; padding: 0; position: relative; display: grid; grid-template-columns: repeat(4, 1fr); background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow-lg); }
  .stats li { padding: 1.3rem 1.2rem; border-left: 1px solid var(--line); display: grid; gap: 0.2rem; }
  .stats li:first-child { border-left: 0; }
  .stats strong { font-size: clamp(1.4rem, 2.6vw, 1.9rem); color: var(--violet); line-height: 1.1; }
  .stats span { font-size: 0.9rem; color: var(--muted); }

  .unesco { display: flex; gap: 1rem; align-items: center; margin-top: 1.2rem; padding: 0.9rem 1.2rem; background: #fff; border: 1px solid var(--line); border-left: 4px solid var(--violet-vivo); border-radius: var(--radius); color: var(--ink); text-decoration: none; }
  .unesco:hover { background: var(--violet-soft); text-decoration: none; }
  .unesco strong { display: block; }
  .unesco small { color: var(--muted); font-size: 0.9rem; }
  .sello { flex: 0 0 auto; font-weight: 800; letter-spacing: 0.08em; font-size: 0.8rem; color: #fff; background: var(--violet); padding: 0.45rem 0.6rem; border-radius: var(--radius); }
  .tabla-wrap { overflow-x: auto; margin: 1.2rem 0 1rem; border: 1px solid var(--line); border-radius: var(--radius); background: #fff; }
  .tabla { width: 100%; border-collapse: collapse; font-size: 0.97rem; min-width: 560px; }
  .tabla th { text-align: left; background: var(--violet); color: #fff; font-weight: 600; padding: 0.75rem 1rem; }
  .tabla td { padding: 0.75rem 1rem; border-top: 1px solid var(--line); }
  .tabla tr.promo td { background: #fbf6fd; }
  .sim { display: grid; grid-template-columns: 1fr 1fr; gap: 0; margin: 1.5rem 0 1rem; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow-lg); overflow: hidden; }
  .sim-in { padding: 1.5rem; display: grid; gap: 0.9rem; align-content: start; }
  .sim-in h3, .sim-in p { margin: 0; }
  .sim-in label { display: grid; gap: 0.35rem; font-weight: 600; font-size: 0.95rem; }
  .sim-in select { font: inherit; padding: 0.6rem 0.7rem; border: 1px solid var(--line); border-radius: var(--radius); background: #fff; }
  .sim-in input[type='range'] { width: 100%; accent-color: var(--violet); }
  .sim-in fieldset { border: 0; padding: 0; margin: 0; display: flex; gap: 1.2rem; flex-wrap: wrap; }
  .sim-in legend { font-weight: 600; font-size: 0.95rem; margin-bottom: 0.35rem; }
  .sim-in .rango { font-weight: 400; color: var(--muted); font-size: 0.82rem; }
  .sim-in .radio { display: flex; align-items: center; gap: 0.4rem; font-weight: 400; }
  .sim-out { background: var(--violet); color: #fff; padding: 1.5rem; display: grid; gap: 0.7rem; align-content: start; }
  .sim-out div { display: flex; justify-content: space-between; gap: 1rem; border-bottom: 1px solid rgba(255, 255, 255, 0.15); padding-bottom: 0.55rem; }
  .sim-out span { opacity: 0.85; }
  .sim-out .big strong { font-size: 1.6rem; }
  .sim-out .btn { justify-content: center; margin-top: 0.4rem; }
  .sim-out small { opacity: 0.75; font-size: 0.78rem; }
  /* Sections plus serrées sur cette page longue */
  .section { padding-block: clamp(1.75rem, 3.5vw, 2.75rem); }
  .vivir { align-items: center; }
  .dos { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start; }
  .fondo { background: var(--violet-soft); }
  .fotos-reales { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; align-self: center; }
  .fotos-reales img { aspect-ratio: 4 / 5; }
  figure { margin: 0; position: relative; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); background: #fff; }
  figure img { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; }
  .fotos-reales figcaption { position: absolute; left: 0.6rem; bottom: 0.6rem; font-size: 0.78rem; background: rgba(255, 255, 255, 0.92); padding: 0.15rem 0.5rem; border-radius: var(--radius); }

  .galeria { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin: 1.5rem 0; }
  .galeria img { aspect-ratio: 7 / 5; }
  .galeria figcaption { padding: 0.7rem 0.8rem; display: grid; }
  .galeria small { color: var(--muted); font-size: 0.75rem; }
  /* Équipements : grille régulière de 12 cases (4 × 3), sans élément orphelin */
  .amen { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.6rem; }
  .amen li { display: flex; align-items: center; gap: 0.6rem; padding: 0.7rem 0.9rem; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); font-size: 0.95rem; line-height: 1.3; }
  .amen li::before { content: '✓'; flex: 0 0 1.5rem; height: 1.5rem; display: grid; place-items: center; border-radius: 50%; background: var(--violet-soft); color: var(--violet); font-weight: 700; font-size: 0.8rem; }

  .dist { list-style: none; padding: 0; margin: 0 0 1.3rem; }
  .dist li { display: flex; justify-content: space-between; padding: 0.6rem 0; border-bottom: 1px solid var(--line); }
  .dist strong { color: var(--violet); }
  .etapas { list-style: none; padding: 0; margin: 0 0 1rem; border-left: 3px solid var(--violet); }
  .etapas li { padding: 0.45rem 0 0.45rem 1rem; position: relative; display: grid; }
  .etapas li::before { content: ''; position: absolute; left: -8px; top: 0.85rem; width: 13px; height: 13px; border-radius: 50%; background: #fff; border: 3px solid var(--violet); }
  .etapas span { color: var(--muted); font-size: 0.95rem; }
  .tip { margin: 1.3rem 0 0; background: var(--violet-soft); padding: 0.8rem 1rem; border-radius: var(--radius); font-size: 0.95rem; }

  .tarjeta { background: #fff; border: 1px solid var(--line); border-top: 4px solid var(--violet); border-radius: var(--radius); padding: 1.6rem; box-shadow: var(--shadow); height: 100%; }
  .casa { border-top-color: var(--violet-vivo); display: flex; flex-direction: column; align-items: flex-start; }
  .casa-img { margin-top: 1.4rem; width: 100%; flex: 1; min-height: 200px; box-shadow: none; }
  .casa-img img { height: 100%; aspect-ratio: auto; }
  .casa-img figcaption { position: absolute; left: 0.6rem; bottom: 0.6rem; font-size: 0.75rem; background: rgba(255, 255, 255, 0.92); padding: 0.15rem 0.5rem; border-radius: var(--radius); }
  .barras { display: flex; gap: 1.2rem; align-items: flex-end; height: 120px; margin: 1rem 0 1.2rem; }
  .barras div { display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; width: 90px; }
  .barras span { width: 100%; background: linear-gradient(180deg, var(--violet-700), var(--violet)); border-radius: var(--radius) var(--radius) 0 0; }
  .barras small { margin-top: 0.4rem; font-weight: 700; }
  .nota { font-size: 0.85rem; color: var(--muted); font-style: italic; margin: 0; }

  .cal { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.2rem; margin-top: 1.5rem; }
  .cal > div { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.3rem; }
  .cal h3 { font-size: 1.1rem; }
  .cal p { margin: 0; color: var(--muted); font-size: 0.95rem; }
  .num { display: inline-grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; background: var(--violet); color: #fff; font-weight: 700; margin-bottom: 0.7rem; }

  .faq { max-width: 820px; }
  details { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); margin-bottom: 0.6rem; }
  summary { cursor: pointer; padding: 1rem 1.2rem; font-weight: 600; }
  details p { padding: 0 1.2rem 1rem; margin: 0; }

  .final { text-align: center; max-width: 720px; }
  .fuente { margin-top: 2rem; font-size: 0.8rem; color: var(--muted); }

  @media (max-width: 900px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stats li:nth-child(3) { border-left: 0; }
    .stats li:nth-child(n + 3) { border-top: 1px solid var(--line); }
    .galeria, .cal { grid-template-columns: repeat(2, 1fr); }
    .sim { grid-template-columns: 1fr; }
    .amen { grid-template-columns: repeat(3, 1fr); }
    .dos { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .amen { grid-template-columns: repeat(2, 1fr); }
    .amen li { padding: 0.6rem 0.65rem; font-size: 0.9rem; gap: 0.45rem; }
    .galeria, .cal { grid-template-columns: 1fr; }
    .acciones .btn { width: 100%; justify-content: center; }
  }
</style>
