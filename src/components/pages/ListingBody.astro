---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ListadoBiens from '../ListadoBiens.astro';
import PresentacionEdificio from '../PresentacionEdificio.astro';
import BannerAregua from '../aregua/BannerAregua.astro';
import PanelDestacados from '../temporal/PanelDestacados.astro';
import { hayPanel } from '../temporal/datos';
import BannerKalypso from '../BannerKalypso.astro';
import { esKalypso } from '../../lib/desarrollos';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';

interface Props {
  kind: 'comprar' | 'alquilar' | 'terrenos' | 'desarrollos' | 'kalypso';
}
const { kind } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const todos = await getCollection('biens', (b) => b.data.en_linea !== false && b.data.operacion !== 'temporal');
let biens = todos;
if (kind === 'comprar') {
  // Comprar = biens déjà construits : les programmes neufs (« pozo ») n'apparaissent que dans Desarrollos.
  biens = todos.filter(
    (b) => b.data.operacion === 'venta' && b.data.tipo !== 'terreno' && !b.data.desarrollo
  );
} else if (kind === 'alquilar') {
  biens = todos.filter((b) => b.data.operacion === 'alquiler');
} else if (kind === 'terrenos') {
  biens = todos.filter((b) => b.data.tipo === 'terreno');
} else if (kind === 'desarrollos') {
  // Comprar en pozo : bandeau Kalypso (notre programme, page à part) + programmes des autres promoteurs,
  // regroupés par projet puis par prix
  biens = todos
    .filter((b) => b.data.desarrollo && !esKalypso(b.data))
    .sort((a, b) =>
      (a.data.proyecto ?? a.data.promotor ?? '').localeCompare(b.data.proyecto ?? b.data.promotor ?? '') ||
      a.data.precio - b.data.precio);
} else if (kind === 'kalypso') {
  // Page Kalypso Recoleta : nos propres unités, du moins cher au plus cher
  biens = todos.filter((b) => esKalypso(b.data)).sort((a, b) => a.data.precio - b.data.precio);
}
if (kind !== 'desarrollos' && kind !== 'kalypso') biens = biens.sort((a, b) => +b.data.fecha - +a.data.fecha);
const enPozo = kind === 'desarrollos' || kind === 'kalypso';

const mostrarDormitorios = kind !== 'terrenos';
const mostrarBanos = kind !== 'terrenos' && !enPozo;

// Bande « Destacados » sous les filtres (rien du tout s'il n'y en a pas)
const conPanel = kind === 'kalypso' ? false : await hayPanel(kind);

const titulo = t(`lista.${kind}_title`);
const eyebrow = t(`lista.${kind}_eyebrow`);
const intro = t(`lista.${kind}_intro`);
---

<Layout zona title={titulo} description={intro}>
  <ListadoBiens
    eyebrow={eyebrow}
    titulo={titulo}
    intro={intro}
    biens={biens}
    mostrarDormitorios={mostrarDormitorios}
    mostrarBanos={mostrarBanos}
    sinFiltros={enPozo}
    ocultarVacia={kind === 'desarrollos'}
    volver={kind === 'kalypso' ? { href: localizePath('/desarrollos', lang), label: t('nav.desarrollos') } : undefined}
    tituloLista={kind === 'kalypso' ? t('des.modelos') : kind === 'desarrollos' && biens.length > 0 ? t('des.otros') : undefined}
  >
    {conPanel && <PanelDestacados slot="destacados" rubrica={kind} />}
    {/* Une seule expression pour le slot « intro » : deux expressions visant le même slot
         s'écrasaient, et la présentation Kalypso n'apparaissait pas. */}
    {kind === 'desarrollos' ? <BannerKalypso slot="intro" />
      : kind === 'kalypso' ? <PresentacionEdificio slot="intro" />
      : kind === 'terrenos' ? <BannerAregua slot="intro" /> : null}
  </ListadoBiens>
</Layout>


