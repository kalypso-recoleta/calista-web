---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ListadoBiens from '../ListadoBiens.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';

interface Props {
  kind: 'comprar' | 'alquilar' | 'terrenos' | 'desarrollos';
}
const { kind } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const todos = await getCollection('biens');
let biens = todos;
if (kind === 'comprar') {
  // Comprar = biens déjà construits : les programmes neufs (« pozo ») n'apparaissent que dans Desarrollos.
  biens = todos.filter(
    (b) => b.data.operacion === 'venta' && b.data.tipo !== 'terreno' && !b.data.desarrollo
  );
} else if (kind === 'alquilar') {
  biens = todos.filter((b) => b.data.operacion === 'alquiler');
} else if (kind === 'terrenos') {
  biens = todos.filter((b) => b.data.tipo === 'terreno');
} else if (kind === 'desarrollos') {
  biens = todos.filter((b) => b.data.desarrollo);
}
biens = biens.sort((a, b) => +b.data.fecha - +a.data.fecha);

const mostrarDormitorios = kind !== 'terrenos';
const mostrarBanos = kind !== 'terrenos' && kind !== 'desarrollos';

const titulo = t(`lista.${kind}_title`);
const eyebrow = t(`lista.${kind}_eyebrow`);
const intro = t(`lista.${kind}_intro`);
---

<Layout title={titulo} description={intro}>
  <ListadoBiens
    eyebrow={eyebrow}
    titulo={titulo}
    intro={intro}
    biens={biens}
    mostrarDormitorios={mostrarDormitorios}
    mostrarBanos={mostrarBanos}
  >
    {
      kind === 'alquilar' && (
        <a class="temp-banner" href={localizePath('/alquiler-temporal', lang)}>
          <span>{t('temp.banner')}</span>
          <strong>{t('temp.banner_cta')} →</strong>
        </a>
      )
    }
    {
      kind === 'desarrollos' && (
        <p class="promotor">
          {t('lista.desarrollos_promotor')}{' '}
          <a href="https://www.elsolar.com.py" target="_blank" rel="noopener">El Solar SRL</a>
          {' · '}
          {t('lista.desarrollos_mas_info')}{' '}
          <a href="https://www.kalypso.com.py" target="_blank" rel="noopener">www.kalypso.com.py</a>
        </p>
      )
    }
  </ListadoBiens>
</Layout>

<style>
  .promotor {
    margin: 0.9rem 0 0;
    padding: 0.7rem 1rem;
    background: #fff;
    border: 1px solid var(--line);
    border-left: 3px solid var(--violet);
    border-radius: var(--radius);
    font-size: 0.95rem;
    color: var(--ink);
  }
  .promotor a {
    font-weight: 700;
  }
  .temp-banner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    margin: 0.9rem 0 0;
    padding: 0.8rem 1rem;
    background: var(--violet);
    color: #fff;
    border-radius: var(--radius);
  }
  .temp-banner:hover {
    text-decoration: none;
    background: var(--violet-700);
  }
</style>
