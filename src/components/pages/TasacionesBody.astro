---
import Layout from '../../layouts/Layout.astro';
import WhatsAppButton from '../WhatsAppButton.astro';
import { whatsappLink } from '../../lib/whatsapp';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const L = (p: string) => localizePath(p, lang);
const wa = whatsappLink(t('tas.wa_msg'));
const waSuc = whatsappLink(t('tas.suc_msg'));
const tipos = [
  { t: t('tas.v_t'), d: t('tas.v_d') },
  { t: t('tas.a_t'), d: t('tas.a_d') },
];
const pasos = [1, 2, 3].map((n) => ({ n: `0${n}`, t: t(`tas.p${n}_t`), d: t(`tas.p${n}_d`) }));
---

<Layout title={t('tas.title')} description={t('tas.lead')}>
  <section class="section hero">
    <div class="container narrow">
      <p class="eyebrow">{t('tas.eyebrow')}</p>
      <h1>{t('tas.title')}</h1>
      <p class="lead">{t('tas.lead')}</p>
      <div class="cta-linea">
        <WhatsAppButton href={wa} label={t('tas.cta_wa')} />
        <a href={L('/contacto')} class="btn btn--ghost">{t('prop.cierre_form')}</a>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="tipos">
        {tipos.map((x) => (
          <div class="tipo">
            <h2>{x.t}</h2>
            <p>{x.d}</p>
          </div>
        ))}
      </div>
      <!-- Successions : lien avec l'agence CALISTA en France -->
      <div class="sucesion">
        <span class="bandera" aria-hidden="true">🇫🇷</span>
        <div>
          <p class="eyebrow">{t('tas.suc_eyebrow')}</p>
          <h2>{t('tas.suc_t')}</h2>
          <p>{t('tas.suc_d')}</p>
          <p class="web">{t('tas.suc_web')} <a href="https://www.calista.immo" target="_blank" rel="noopener">www.calista.immo</a></p>
          <WhatsAppButton href={waSuc} label={t('tas.suc_wa')} />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="tit">{t('tas.como_title')}</h2>
      <ol class="pasos">
        {pasos.map((p) => (
          <li>
            <span class="num">{p.n}</span>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </li>
        ))}
      </ol>
      <p class="precio">{t('tas.precio')}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cierre">
        <h2>{t('tas.despues')}</h2>
        <div class="cta-linea center">
          <a href={L('/administracion')} class="btn btn--primary">{t('tas.link_admin')}</a>
          <a href={L('/propietarios') + '#vender'} class="btn btn--ghost on-dark">{t('tas.link_vender')}</a>
          <WhatsAppButton href={wa} label={t('tas.cta_wa')} />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .narrow { max-width: 760px; }
  .hero { padding-bottom: 1rem; }
  .alt { background: var(--surface); border-block: 1px solid var(--line); }
  .tit { margin: 0 0 1.6rem; padding-left: 0.9rem; border-left: 4px solid var(--violet); }
  .tipos { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .tipo { background: #fff; border: 1px solid var(--line); border-top: 4px solid var(--violet); border-radius: var(--radius); padding: 1.8rem 2rem; box-shadow: var(--shadow); }
  .tipo h2 { margin: 0 0 0.5rem; font-size: clamp(1.3rem, 2.2vw, 1.6rem); }
  .tipo p { margin: 0; color: var(--muted); line-height: 1.6; }
  .sucesion { display: flex; gap: 1.4rem; align-items: flex-start; margin-top: 1.5rem; padding: 1.8rem 2rem; background: var(--card-tint); border: 1px solid var(--line); border-left: 5px solid var(--violet); border-radius: var(--radius); box-shadow: var(--shadow); }
  .sucesion .web { margin-top: -0.4rem; color: var(--ink); }
  .web a { font-weight: 700; }
  .bandera { font-size: 2.2rem; line-height: 1; }
  .sucesion h2 { margin: 0 0 0.5rem; font-size: clamp(1.3rem, 2.2vw, 1.6rem); }
  .sucesion p:not(.eyebrow) { margin: 0 0 1.1rem; color: var(--muted); line-height: 1.6; max-width: 70ch; }
  .pasos { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.2rem; }
  .pasos li { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.5rem; box-shadow: var(--shadow); }
  .pasos .num { font-family: var(--display); font-size: 1.1rem; font-weight: 600; color: var(--violet); letter-spacing: 0.05em; }
  .pasos h3 { margin: 0.5rem 0 0.4rem; }
  .pasos p { margin: 0; color: var(--muted); font-size: 0.95rem; }
  .precio { margin: 1.6rem 0 0; font-weight: 600; color: var(--brand); }
  .cta-linea { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.8rem; }
  .cta-linea.center { justify-content: center; }
  .cierre { background: var(--brand); color: #fff; border-radius: var(--radius); padding: clamp(2rem, 5vw, 3.5rem); text-align: center; }
  .cierre h2 { color: #fff; margin: 0; }
  .btn.on-dark { background: transparent; color: #fff; border-color: rgba(255, 255, 255, 0.6); }
  .btn.on-dark:hover { background: rgba(255, 255, 255, 0.12); }
  @media (max-width: 820px) { .tipos, .pasos { grid-template-columns: 1fr; } }
</style>
