---
import { tituloBien } from '../../lib/seo';
import { localizar, cuerpoTraducido } from '../../lib/traduccion';
import { slugify } from '../../lib/slug';
import type { CollectionEntry } from 'astro:content';
import { render, getCollection } from 'astro:content';
import { zonaDeBien } from '../../lib/barrios';
import { guiasPublicadas, hrefGuia } from '../../lib/guias';
import BannerAregua from '../aregua/BannerAregua.astro';
import Layout from '../../layouts/Layout.astro';
import PropertyGallery from '../PropertyGallery.astro';
import PropertyMap from '../PropertyMap.astro';
import WhatsAppButton from '../WhatsAppButton.astro';
import { img } from '../../lib/cloudinary';
import { whatsappBien } from '../../lib/whatsapp';
import { site } from '../../lib/site';
import {
  formatPrecio,
  formatUbicacion,
  formatSuperficie,
  tipoLabel,
  operacionLabel,
  estadoLabel,
} from '../../lib/format';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';

interface Props {
  bien: CollectionEntry<'biens'>;
}
const { bien } = Astro.props;
const d = localizar(bien.data, getLangFromUrl(Astro.url));
const htmlTraducido = cuerpoTraducido(bien.data, getLangFromUrl(Astro.url));

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const L = (p: string) => localizePath(p, lang);

const { Content } = await render(bien);
const zona = await zonaDeBien(bien);
const masEn = { es: 'Ver más propiedades en', fr: 'Voir plus de biens à', en: 'See more properties in', pt: 'Ver mais imóveis em' }[getLangFromUrl(Astro.url) as 'es' | 'fr' | 'en' | 'pt'];

const url = new URL(`/propiedad/${slugify(bien.id)}`, Astro.site).toString();
const wa = whatsappBien({ titulo: bien.data.titulo, ref: slugify(bien.id), url });
const superficie = formatSuperficie(d, lang);
// La portada explicite passe en tête de galerie et sert d'image de partage
const fotos = d.portada_foto
  ? [d.portada_foto, ...d.imagenes.filter((f) => f !== d.portada_foto)]
  : d.imagenes;
const ogImage = fotos[0] ? img(fotos[0], { w: 1200, h: 630 }) : undefined;

// Données structurées de l'annonce (prix, devise, disponibilité, attributs).
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const DISPONIBILIDAD: Record<string, string> = {
  disponible: 'https://schema.org/InStock',
  reservado: 'https://schema.org/LimitedAvailability',
  vendido: 'https://schema.org/SoldOut',
  alquilado: 'https://schema.org/OutOfStock',
};
const atributos = [
  d.dormitorios != null && { '@type': 'PropertyValue', name: 'dormitorios', value: d.dormitorios },
  d.banos != null && { '@type': 'PropertyValue', name: 'banos', value: d.banos },
  d.cocheras != null && { '@type': 'PropertyValue', name: 'cocheras', value: d.cocheras },
  (d.superficie_construida || d.superficie_terreno) && {
    '@type': 'PropertyValue',
    name: 'superficie_m2',
    value: d.superficie_construida || d.superficie_terreno,
    unitCode: 'MTK',
  },
].filter(Boolean);

// Données structurées : annonce immobilière (RealEstateListing) et non « Product ».
// Le type Product déclenchait les contrôles « Fiches de marchand » de Google
// (livraison, politique de retour, brand…), qui n'ont pas de sens pour un bien.
const TIPO_SCHEMA: Record<string, string> = {
  departamento: 'Apartment',
  casa: 'House',
  duplex: 'House',
  quinta: 'House',
};
const tipoSchema = TIPO_SCHEMA[d.tipo] ?? 'Place';
const esVivienda = tipoSchema !== 'Place';
const superficieM2 = d.superficie_construida || d.superficie_terreno;
const agencia = { '@type': 'RealEstateAgent', name: site.nombre, url: new URL('/', Astro.site).toString() };

const listingSchema = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateListing',
  name: d.titulo,
  description: d.descripcion,
  url: canonical,
  image: ogImage ? [new URL(ogImage, Astro.site).toString()] : undefined,
  datePosted: d.fecha instanceof Date ? d.fecha.toISOString().slice(0, 10) : undefined,
  provider: agencia,
  about: {
    '@type': tipoSchema,
    name: d.titulo,
    address: {
      '@type': 'PostalAddress',
      addressLocality: d.barrio ? `${d.barrio}, ${d.ciudad}` : d.ciudad,
      addressCountry: 'PY',
    },
    ...(esVivienda && d.dormitorios != null ? { numberOfBedrooms: d.dormitorios } : {}),
    ...(esVivienda && d.banos != null ? { numberOfBathroomsTotal: d.banos } : {}),
    ...(esVivienda && superficieM2
      ? { floorSize: { '@type': 'QuantitativeValue', value: superficieM2, unitCode: 'MTK' } }
      : {}),
    additionalProperty: atributos,
  },
  ...(d.precio > 0
    ? {
        offers: {
          '@type': 'Offer',
          price: d.precio,
          priceCurrency: d.moneda,
          availability: DISPONIBILIDAD[d.estado] ?? 'https://schema.org/InStock',
          businessFunction:
            d.operacion === 'venta'
              ? 'http://purl.org/goodrelations/v1#Sell'
              : 'http://purl.org/goodrelations/v1#LeaseOut',
          url: canonical,
          seller: agencia,
        },
      }
    : {}),
};

const specs = [
  d.dormitorios != null && { label: t('spec.dormitorios'), value: d.dormitorios },
  d.banos != null && { label: t('spec.banos_full'), value: d.banos },
  d.cocheras != null && { label: t('spec.cocheras'), value: d.cocheras },
  // Surface : valeur courte (« 59 m² ») et précision dans le libellé, pour tenir sur une ligne sur téléphone
  superficie && (d.tipo !== 'terreno' && d.superficie_construida
    ? { label: t('spec.sup_construida'), value: `${d.superficie_construida} m²` }
    : d.superficie_terreno
      ? { label: t('spec.sup_terreno'), value: `${d.superficie_terreno} m²` }
      : { label: t('spec.superficie'), value: superficie }),
  d.entrega && { label: t('spec.entrega'), value: d.entrega },
  d.financiacion && { label: t('spec.financiacion'), value: t('spec.financiacion_si') },
].filter(Boolean) as { label: string; value: string | number }[];

// ── Bloc d'informations complémentaires (SEO) ──
// Tout vient de données déjà présentes sur le site (fiche, page du barrio, autres annonces, blog) :
// aucun texte inventé. Il donne aux fiches courtes un contenu utile et des liens internes.
type L4 = 'es' | 'fr' | 'en' | 'pt';
const lg = lang as L4;
const XB = {
  es: { res: 'En resumen', sim: 'Otras propiedades que pueden interesarte', art: 'Para preparar tu proyecto' },
  fr: { res: 'En résumé', sim: 'D’autres biens qui peuvent vous intéresser', art: 'Pour préparer votre projet' },
  en: { res: 'In short', sim: 'Other properties you may like', art: 'To prepare your project' },
  pt: { res: 'Em resumo', sim: 'Outros imóveis que podem interessar', art: 'Para preparar o seu projeto' },
}[lg];
// Phrase de synthèse construite à partir des caractéristiques de la fiche
const n = d.dormitorios ?? 0;
const m2 = d.tipo === 'terreno' ? d.superficie_terreno : d.superficie_construida || d.superficie_terreno;
const lugar = formatUbicacion(d);
const precioDesde = d.desarrollo && !d.precio_unico;
const precioTxt = d.precio > 0 ? formatPrecio(d, lang) : '';
// « por X » / « au prix de X »… ; pour un prix « à partir de » (pozo) : « desde X » / « à partir de X »…
const PRE = { es: precioDesde ? 'desde' : 'por', fr: precioDesde ? 'à partir de' : 'au prix de', en: precioDesde ? 'from' : 'priced at', pt: precioDesde ? 'a partir de' : 'por' }[lg];
const tipoTxt = tipoLabel(d.tipo, lang);
const OP = { venta: { es: 'en venta', fr: 'à vendre', en: 'for sale', pt: 'à venda' }, alquiler: { es: 'en alquiler', fr: 'à louer', en: 'for rent', pt: 'para alugar' } } as Record<string, Record<L4, string>>;
const opTxt = OP[d.operacion]?.[lg] ?? '';
const resumen = {
  es: `${tipoTxt}${n ? ` de ${n} dormitorio${n > 1 ? 's' : ''}` : ''}${m2 ? ` con ${m2} m²` : ''} ${opTxt}${lugar ? ` en ${lugar}` : ''}${precioTxt ? `, ${PRE} ${precioTxt}` : ''}.`,
  fr: `${tipoTxt}${n ? ` de ${n} chambre${n > 1 ? 's' : ''}` : ''}${m2 ? ` de ${m2} m²` : ''} ${opTxt}${lugar ? ` à ${lugar}` : ''}${precioTxt ? `, ${PRE} ${precioTxt}` : ''}.`,
  en: `${n ? `${n}-bedroom ${tipoTxt.toLowerCase()}` : tipoTxt}${m2 ? ` of ${m2} m²` : ''} ${opTxt}${lugar ? ` in ${lugar}` : ''}${precioTxt ? `, ${PRE} ${precioTxt}` : ''}.`,
  pt: `${tipoTxt}${n ? ` de ${n} quarto${n > 1 ? 's' : ''}` : ''}${m2 ? ` com ${m2} m²` : ''} ${opTxt}${lugar ? ` em ${lugar}` : ''}${precioTxt ? `, ${PRE} ${precioTxt}` : ''}.`,
}[lg].replace(/\s+/g, ' ');
const entregaTxt = d.desarrollo && d.entrega ? { es: `Entrega prevista: ${d.entrega}.`, fr: `Livraison prévue : ${d.entrega}.`, en: `Expected handover: ${d.entrega}.`, pt: `Entrega prevista: ${d.entrega}.` }[lg] : '';
// Présentation courte du barrio (texte de la page du barrio, dans la langue de la page)
const zd = zona?.entry.data as (Record<string, unknown> & { intro?: string }) | undefined;
const introBarrio = zd ? (lang === 'es' ? zd.intro : (zd[lang] as { intro?: string } | undefined)?.intro)?.trim() : undefined;
// Autres annonces : même barrio d'abord, puis même type d'opération et de bien
const otrosBienes = (await getCollection('biens', (b) => b.data.en_linea !== false && b.data.operacion === bien.data.operacion && b.id !== bien.id && (b.data.estado === 'disponible' || b.data.estado === 'reservado')))
  .map((b) => ({ b, p: (zona?.bienes.some((x) => x.id === b.id) ? 4 : 0) + (b.data.tipo === bien.data.tipo ? 2 : 0) + (b.data.ciudad === bien.data.ciudad ? 1 : 0) }))
  .filter((x) => x.p > 0)
  .sort((a, c) => c.p - a.p)
  .slice(0, 3)
  .map(({ b }) => { const db = localizar(b.data, lang); return { href: localizePath(`/propiedad/${slugify(b.id)}`, lang), titulo: db.titulo, info: [formatUbicacion(db), formatPrecio(db, lang)].filter(Boolean).join(' · ') }; });
// Articles du blog liés au projet (achat ou location), seulement s'ils existent dans la langue de la page
const TEMAS_OP: Record<string, string[]> = { venta: ['comprar', 'invertir'], alquiler: ['alquilar', 'propietarios'] };
const temasOp = TEMAS_OP[d.operacion] ?? [];
const articulos = (await guiasPublicadas())
  .filter((g) => g.entry.data.tema && temasOp.includes(g.entry.data.tema))
  .filter((g) => lang === 'es' || !!(g.entry.data as unknown as Record<string, { cuerpo?: string } | undefined>)[lang]?.cuerpo?.trim())
  .sort((a, c) => temasOp.indexOf(a.entry.data.tema!) - temasOp.indexOf(c.entry.data.tema!))
  .slice(0, 3)
  .map((g) => ({ href: hrefGuia(g.entry, lang), titulo: localizar(g.entry.data, lang).titulo }));
---

<Layout title={tituloBien(bien.data, getLangFromUrl(Astro.url))} tituloCompleto description={d.descripcion} image={ogImage}>
  <article class="section detalle">
    <script type="application/ld+json" set:html={JSON.stringify(listingSchema)} />
    <div class="container">
      <nav class="crumbs" aria-label="•">
        <a href={L('/')}>{t('det.inicio')}</a>
        <span>/</span>
        <a href={d.operacion === 'venta' ? L('/comprar') : L('/alquilar')}>
          {operacionLabel(d.operacion, lang)}
        </a>
        <span>/</span>
        <span>{d.titulo}</span>
      </nav>

      <PropertyGallery imagenes={fotos} titulo={d.titulo} />
      {/* Fiche Areguá Forest : lien vers la page dédiée */}
      {slugify(bien.id).includes('aregua-forest') && <div class="banner-af"><BannerAregua /></div>}

      <div class="layout">
        <div class="main">
          <p class="loc">{tipoLabel(d.tipo, lang)} · {formatUbicacion(d)}</p>
          <h1>{d.titulo}</h1>

          <div class="meta-row">
            <span class="badge">{operacionLabel(d.operacion, lang)}</span>
            {d.desarrollo && <span class="badge">{t('badge.pozo_largo')}</span>}
            {d.exclusivo && <span class="badge badge--exclusivo">{t('badge.exclusivo')}</span>}
            {
              d.estado !== 'disponible' && (
                <span class={`badge badge--${d.estado}`}>{estadoLabel(d.estado, lang)}</span>
              )
            }
          </div>

          {
            specs.length > 0 && (
              <ul class="specs">
                {specs.map((s) => (
                  <li>
                    <span class="v">{s.value}</span>
                    <span class="k">{s.label}</span>
                  </li>
                ))}
              </ul>
            )
          }

          <div class="prose">
            {htmlTraducido ? <Fragment set:html={htmlTraducido} /> : <Content />}
          </div>

          <div class="mapa">
            <h3>{t('det.ubicacion')}</h3>
            <PropertyMap ubicacion={d.ubicacion} zona={formatUbicacion(d)} ciudad={d.ciudad} />
            {zona && introBarrio && <p class="intro-zona">{introBarrio}</p>}
            {zona && <a class="mas-zona" href={localizePath(`/barrios/${zona.slug}`, getLangFromUrl(Astro.url))}>{masEn} {zona.nombre} →</a>}
          </div>

          <section class="extra">
            <h2>{XB.res}</h2>
            <p>{resumen}{entregaTxt && ` ${entregaTxt}`}</p>
            {otrosBienes.length > 0 && (
              <>
                <h2>{XB.sim}</h2>
                <ul class="enlaces">
                  {otrosBienes.map((o) => <li><a href={o.href}>{o.titulo}</a><span>{o.info}</span></li>)}
                </ul>
              </>
            )}
            {articulos.length > 0 && (
              <>
                <h2>{XB.art}</h2>
                <ul class="enlaces">
                  {articulos.map((a) => <li><a href={a.href}>{a.titulo}</a></li>)}
                </ul>
              </>
            )}
          </section>
        </div>

        <aside class="side">
          <div class="cta-card">
            <p class="precio">{d.desarrollo && !d.precio_unico && d.precio > 0 && <small class="desde">{t('tar.desde')} </small>}{formatPrecio(d, lang)}</p>
            <p class="ref">{t('det.ref')} {slugify(bien.id)}</p>
            <WhatsAppButton href={wa} full />
            {
              d.ficha_pdf && (
                <div class="ficha-bloque">
                  {/* 1) Consulter : le PDF s'ouvre dans un nouvel onglet (lecteur du navigateur) */}
                  <a href={d.ficha_pdf} class="btn btn--primary full-ghost ficha" target="_blank" rel="noopener">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" />
                    </svg>
                    {t('det.ficha_ver')}
                  </a>
                  {/* 2) Télécharger : enregistre le fichier directement */}
                  <a href={d.ficha_pdf} class="ficha-descargar" download>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" />
                    </svg>
                    {t('det.ficha_descargar')}
                  </a>
                </div>
              )
            }
            <a href={`${L('/contacto')}?propiedad=${encodeURIComponent(slugify(bien.id))}&titulo=${encodeURIComponent(d.titulo)}`} class="btn btn--ghost full-ghost">
              {t('det.enviar_consulta')}
            </a>
            <button
              type="button"
              class="btn btn--ghost full-ghost compartir"
              data-compartir
              data-titulo={d.titulo}
              data-url={canonical}
              data-copiado={t('det.copiado')}
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" />
                <line x1="8.6" y1="10.5" x2="15.4" y2="6.5" /><line x1="8.6" y1="13.5" x2="15.4" y2="17.5" />
              </svg>
              <span data-label>{t('det.compartir')}</span>
            </button>
            <p class="nota">{t('det.nota')}</p>
          </div>
        </aside>
      </div>
    </div>
  </article>
</Layout>

<style>
  .banner-af { margin-top: 1.5rem; }
  .crumbs {
    display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: 0.85rem;
    color: var(--muted); margin-bottom: 1.2rem;
  }
  .crumbs a { color: var(--muted); }
  .crumbs a:hover { color: var(--brand); }
  .layout {
    display: grid; grid-template-columns: 1fr 340px; gap: 2.5rem;
    margin-top: 2rem; align-items: start;
  }
  .loc { color: var(--muted); margin: 0 0 0.3rem; font-size: 0.9rem; }
  /* Titre d'annonce : plus sobre que les titres de page (souvent long) */
  .main h1 { margin-bottom: 0.8rem; font-size: clamp(1.6rem, 2.6vw, 2.15rem); }
  .meta-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem; }
  .specs {
    list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 0; padding: 0; margin: 0 0 2rem; background: var(--surface);
    border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden;
  }
  /* Pas de fond gris derrière la grille : une case vide en fin de ligne reste blanche */
  .specs li {
    background: var(--surface); padding: 1rem 1.1rem; display: flex;
    flex-direction: column; gap: 0.15rem;
  }
  @media (max-width: 600px) {
    .specs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .specs .v {
    font-family: var(--display); font-size: 1.3rem; font-weight: 600; color: var(--brand);
  }
  .specs .k {
    font-size: 0.78rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em;
  }
  .prose { font-size: 1.06rem; line-height: 1.7; max-width: 64ch; }
  .prose :global(h2), .prose :global(h3) { margin-top: 1.6rem; }
  .prose :global(strong) { color: var(--brand); }
  .mapa { margin-top: 2.5rem; }
  .mapa h3 { margin-bottom: 0.8rem; }
  .mas-zona { display: inline-block; margin-top: 0.9rem; font-weight: 600; color: var(--violet); }
  .intro-zona { margin: 0.9rem 0 0; color: var(--muted); max-width: 64ch; }
  .extra { margin-top: 2.5rem; max-width: 64ch; }
  .extra h2 { font-size: 1.15rem; margin: 1.8rem 0 0.6rem; }
  .extra h2:first-child { margin-top: 0; }
  .extra p { margin: 0; line-height: 1.7; }
  .enlaces { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .enlaces li { display: flex; flex-direction: column; gap: 0.1rem; }
  .enlaces a { color: var(--violet); font-weight: 600; }
  .enlaces span { font-size: 0.85rem; color: var(--muted); }
  .side { position: sticky; top: 92px; }
  .cta-card {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 1.5rem; box-shadow: var(--shadow); display: flex; flex-direction: column; gap: 0.7rem;
  }
  .cta-card .precio .desde { font-size: 0.55em; font-weight: 500; color: var(--muted); }
  .cta-card .precio {
    font-family: var(--display); font-size: 2rem; font-weight: 600; color: var(--brand); margin: 0;
  }
  .cta-card .ref { font-size: 0.8rem; color: var(--muted); margin: -0.4rem 0 0.4rem; }
  .full-ghost { width: 100%; justify-content: center; }
  .ficha-bloque { display: flex; flex-direction: column; align-items: center; gap: 0.35rem; }
  .ficha-descargar {
    display: inline-flex; align-items: center; gap: 0.35rem;
    font-size: 0.85rem; font-weight: 600; color: var(--violet);
  }
  .compartir { display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer; }
  .cta-card .nota { font-size: 0.8rem; color: var(--muted); margin: 0.3rem 0 0; line-height: 1.4; }
  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    .side { position: static; order: -1; }
  }
</style>

<script>
  document.querySelectorAll('[data-compartir]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const titulo = btn.getAttribute('data-titulo') || document.title;
      const url = btn.getAttribute('data-url') || location.href;
      // Mobile : menu de partage natif (WhatsApp, etc.)
      if (navigator.share) {
        try {
          await navigator.share({ title: titulo, url });
          return;
        } catch {
          /* partage annulé → rien à faire */
          return;
        }
      }
      // Ordinateur : copier le lien + confirmation temporaire
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        const tmp = document.createElement('textarea');
        tmp.value = url;
        document.body.appendChild(tmp);
        tmp.select();
        document.execCommand('copy');
        tmp.remove();
      }
      const label = btn.querySelector('[data-label]');
      if (label) {
        const original = label.textContent;
        label.textContent = btn.getAttribute('data-copiado') || 'OK';
        setTimeout(() => (label.textContent = original), 2000);
      }
    });
  });
</script>
