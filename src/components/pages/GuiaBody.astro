---
/** Un guide (article). Texte FR / EN si rempli dans l'admin, sinon l'espagnol. */
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import WhatsAppButton from '../WhatsAppButton.astro';
import Compartir from '../Compartir.astro';
import { whatsappLink } from '../../lib/whatsapp';
import { img } from '../../lib/cloudinary';
import { localizar, cuerpoTraducido } from '../../lib/traduccion';
import { guiasPublicadas } from '../../lib/guias';
import { getLangFromUrl, localizePath } from '../../i18n/utils';

interface Props { guia: CollectionEntry<'guias'>; slug: string }
const { guia, slug } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const L = (p: string) => localizePath(p, lang);
const d = localizar(guia.data, lang);
const html = cuerpoTraducido(guia.data, lang);
const { Content } = await render(guia);
const x = {
  es: { volver: 'Todas las guías', cta_t: '¿Tenés una pregunta sobre este tema?', cta_d: 'Escribinos: te respondemos personalmente, en español, francés o inglés.', wa: 'WhatsApp', f_preg: 'Tu pregunta', f_nombre: 'Nombre', f_email: 'Email', f_tel: 'WhatsApp / teléfono (opcional)', f_enviar: 'Enviar mi pregunta', o: 'o', otras: 'Otras guías', aviso: 'Información general: no reemplaza el asesoramiento de un escribano o un abogado.' },
  fr: { volver: 'Tous les guides', cta_t: 'Une question sur ce sujet ?', cta_d: 'Écrivez-nous : nous vous répondons personnellement, en français, espagnol ou anglais.', wa: 'WhatsApp', f_preg: 'Votre question', f_nombre: 'Nom', f_email: 'E-mail', f_tel: 'WhatsApp / téléphone (facultatif)', f_enviar: 'Envoyer ma question', o: 'ou', otras: 'Autres guides', aviso: 'Information générale : ne remplace pas le conseil d’un notaire (escribano) ou d’un avocat.' },
  en: { volver: 'All guides', cta_t: 'Have a question about this topic?', cta_d: 'Write to us: we reply personally, in English, Spanish or French.', wa: 'WhatsApp', f_preg: 'Your question', f_nombre: 'Name', f_email: 'Email', f_tel: 'WhatsApp / phone (optional)', f_enviar: 'Send my question', o: 'or', otras: 'Other guides', aviso: 'General information: not a substitute for advice from a notary (escribano) or a lawyer.' },
}[lang as 'es' | 'fr' | 'en']!;
const locale = { es: 'es-PY', fr: 'fr-FR', en: 'en-US' }[lang as 'es' | 'fr' | 'en'];
const wa = whatsappLink(`Hola Calista, leí la guía "${guia.data.titulo}" y tengo una consulta.`);
const otras = (await guiasPublicadas()).filter((g) => g.slug !== slug).slice(0, 3).map((g) => ({ slug: g.slug, titulo: localizar(g.entry.data, lang).titulo }));
const url = new URL(Astro.url.pathname, Astro.site).toString();
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.titulo,
  description: d.descripcion,
  datePublished: d.fecha.toISOString(),
  inLanguage: html || lang === 'es' ? lang : 'es',
  mainEntityOfPage: url,
  ...(d.portada_foto ? { image: new URL(d.portada_foto, Astro.site).toString() } : {}),
  author: { '@type': 'Organization', name: 'CALISTA Inmobiliaria', url: new URL('/', Astro.site).toString() },
  publisher: { '@type': 'Organization', name: 'CALISTA Inmobiliaria', logo: { '@type': 'ImageObject', url: new URL('/logo-calista.png', Astro.site).toString() } },
};
---

<Layout title={d.titulo} description={d.descripcion} image={d.portada_foto}>
  <article class="section">
    <div class="container art">
      <p class="migas"><a href={L('/guias')}>← {x.volver}</a></p>
      <h1>{d.titulo}</h1>
      <p class="lead">{d.descripcion}</p>
      <time datetime={d.fecha.toISOString()}>{d.fecha.toLocaleDateString(locale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time>
      <Compartir titulo={d.titulo} url={url} />
      {d.portada_foto && <img class="portada" src={img(d.portada_foto, { w: 1200, h: 630 })} alt="" width="1200" height="630" />}
      <div class="prose">
        {html ? <Fragment set:html={html} /> : <Content />}
      </div>
      <p class="aviso">{x.aviso}</p>
      <div class="share-fin"><Compartir titulo={d.titulo} url={url} /></div>
      <div class="cta" id="pregunta">
        <h2>{x.cta_t}</h2>
        <p>{x.cta_d}</p>
        <!-- Même formulaire Netlify que la page Contacto : arrive dans la même boîte, avec le titre du guide -->
        <form name="contacto" method="POST" data-netlify="true" netlify-honeypot="bot-field" action={L('/gracias')} class="form">
          <input type="hidden" name="form-name" value="contacto" />
          <input type="hidden" name="motivo" value={`Pregunta sobre la guía: ${guia.data.titulo}`} />
          <p class="hp" hidden><label>No llenar: <input name="bot-field" /></label></p>
          <label class="campo"><span>{x.f_preg}</span><textarea name="mensaje" rows="4" required></textarea></label>
          <label class="campo"><span>{x.f_nombre}</span><input type="text" name="nombre" required autocomplete="name" /></label>
          <div class="fila">
            <label class="campo"><span>{x.f_email}</span><input type="email" name="email" required autocomplete="email" /></label>
            <label class="campo"><span>{x.f_tel}</span><input type="tel" name="telefono" autocomplete="tel" /></label>
          </div>
          <div class="acciones">
            <button type="submit" class="btn btn--primary">{x.f_enviar}</button>
            <span class="o">{x.o}</span>
            <WhatsAppButton href={wa} label={x.wa} />
          </div>
        </form>
      </div>
      {otras.length > 0 && (
        <nav class="otras">
          <h2>{x.otras}</h2>
          <ul>{otras.map((o) => <li><a href={L(`/guias/${o.slug}`)}>{o.titulo}</a></li>)}</ul>
        </nav>
      )}
    </div>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</Layout>

<style>
  .art { max-width: 760px; }
  .migas { margin: 0 0 1rem; font-size: 0.92rem; }
  .migas a { color: var(--violet); text-decoration: none; font-weight: 600; }
  h1 { margin-bottom: 0.6rem; }
  time { display: block; font-size: 0.85rem; color: var(--muted); margin: 0.6rem 0 1.6rem; }
  .portada { width: 100%; height: auto; border-radius: var(--radius); margin-bottom: 1.8rem; }
  .prose { font-size: 1.06rem; line-height: 1.75; }
  .prose :global(h2) { margin-top: 2.2rem; padding-left: 0.8rem; border-left: 4px solid var(--violet); font-size: 1.4rem; }
  .prose :global(h3) { margin-top: 1.6rem; }
  .prose :global(strong) { color: var(--brand); }
  .prose :global(li) { margin: 0.35rem 0; }
  .share-fin { margin-top: 1.6rem; }
  .aviso { margin-top: 2rem; font-size: 0.88rem; font-style: italic; color: var(--muted); }
  .cta { margin-top: 2.5rem; padding: 1.8rem; background: var(--card-tint); border: 1px solid var(--line); border-left: 5px solid var(--violet); border-radius: var(--radius); }
  .cta h2 { margin: 0 0 0.4rem; }
  .cta p { margin: 0 0 1.1rem; color: var(--muted); }
  .form { display: flex; flex-direction: column; gap: 1rem; }
  .fila { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .campo { display: flex; flex-direction: column; gap: 0.35rem; }
  .campo > span { font-size: 0.85rem; font-weight: 600; color: var(--ink); }
  .form input, .form textarea { font-family: var(--body); font-size: 1rem; color: var(--ink); padding: 0.75rem 0.85rem; border: 1px solid var(--line); border-radius: var(--radius-sm); background: #fff; width: 100%; }
  .form input:focus, .form textarea:focus { outline: none; border-color: var(--violet); box-shadow: 0 0 0 3px var(--violet-soft); }
  .acciones { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem; }
  .o { color: var(--muted); font-size: 0.9rem; }
  @media (max-width: 600px) { .fila { grid-template-columns: 1fr; } }
  .otras { margin-top: 2.5rem; }
  .otras h2 { font-size: 1.2rem; margin-bottom: 0.6rem; }
  .otras ul { margin: 0; padding-left: 1.2rem; }
  .otras a { color: var(--violet); font-weight: 600; }
</style>
