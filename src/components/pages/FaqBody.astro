---
/**
 * Preguntas frecuentes : réponses courtes et factuelles (tarifs, démarches).
 * Balisage FAQPage pour Google et les moteurs de réponse (IA).
 * ⚠️ Ne mettre ici que des informations vérifiées par Hélène.
 */
import Layout from '../../layouts/Layout.astro';
import WhatsAppButton from '../WhatsAppButton.astro';
import { whatsappLink } from '../../lib/whatsapp';
import { getLangFromUrl, localizePath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const L = (p: string) => localizePath(p, lang);

type QA = { q: string; a: string; link?: { href: string; label: string } };
const TXT: Record<string, { eyebrow: string; title: string; lead: string; mas: string; wa: string; items: QA[] }> = {
  es: {
    eyebrow: 'Preguntas frecuentes',
    title: 'Lo que más nos preguntan',
    lead: 'Respuestas claras sobre nuestros servicios y tarifas. ¿No encontrás la tuya? Escribinos.',
    mas: 'Ver más',
    wa: 'Hacer una consulta',
    items: [
      { q: '¿Cuánto cobra CALISTA por administrar un alquiler?', a: 'El 5 % de los alquileres efectivamente cobrados, cada mes, más IVA (10 %). Incluye el cobro del alquiler, la rendición mensual, la coordinación del mantenimiento y la relación con el inquilino.', link: { href: '/administracion', label: 'Administración de alquileres' } },
      { q: '¿Cuánto cuesta poner mi propiedad en alquiler?', a: 'Un mes de alquiler, repartido 50 % a cargo del propietario y 50 % a cargo del inquilino. Incluye la búsqueda del inquilino, el contrato y el inventario de entrada. Si compraste tu propiedad con CALISTA, la puesta en alquiler de tu primer inquilino es sin cargo.' },
      { q: '¿Cuánto cobran por vender una propiedad?', a: 'El 5 % del precio de venta, IVA incluido, a cargo del vendedor. El comprador no paga comisión a CALISTA.', link: { href: '/propietarios', label: 'Vender' } },
      { q: '¿Cuánto cuesta una tasación?', a: 'Depende de la propiedad: te enviamos un presupuesto sin compromiso. Hacemos tasaciones para vender y para alquilar.', link: { href: '/tasaciones', label: 'Tasaciones' } },
      { q: '¿Hacen informes de tasación para una sucesión tramitada en Francia?', a: 'Sí. Con nuestra agencia en Francia, CALISTA Immobilier (Martinica, www.calista.immo), preparamos el informe de tasación en francés para el notario.', link: { href: '/tasaciones', label: 'Tasaciones' } },
      { q: '¿Cuál es la estadía mínima y máxima en alquiler temporal?', a: 'De 7 días a 6 meses, en departamentos amoblados. Alquilamos en directo, sin plataformas ni intermediarios. El wifi está incluido; los demás servicios dependen de la duración de la estadía.', link: { href: '/alquiler-temporal', label: 'Alquiler temporal' } },
      { q: '¿Cómo se paga un departamento en pozo de Kalypso Recoleta?', a: '10 % de entrega y el saldo en 32 cuotas sin intereses durante la obra. La entrega está prevista para mayo de 2029.', link: { href: '/desarrollos', label: 'Desarrollos Kalypso' } },
      { q: '¿En qué zonas trabajan?', a: 'En Asunción y sus alrededores.' },
      { q: '¿Atienden en francés o en inglés?', a: 'Sí: atendemos en español, francés e inglés.' },
    ],
  },
  fr: {
    eyebrow: 'Questions fréquentes',
    title: 'Ce que l’on nous demande le plus',
    lead: 'Des réponses claires sur nos services et nos tarifs. Vous ne trouvez pas la vôtre ? Écrivez-nous.',
    mas: 'En savoir plus',
    wa: 'Poser une question',
    items: [
      { q: 'Combien coûte la gestion locative avec CALISTA ?', a: '5 % des loyers réellement encaissés, chaque mois, plus TVA (IVA 10 %). Cela comprend l’encaissement du loyer, le relevé mensuel, la coordination de l’entretien et la relation avec le locataire.', link: { href: '/administracion', label: 'Gestion locative' } },
      { q: 'Combien coûte la mise en location de mon bien ?', a: 'Un mois de loyer, partagé à 50 % pour le propriétaire et 50 % pour le locataire. Cela comprend la recherche du locataire, le bail et l’état des lieux d’entrée. Si vous avez acheté votre bien avec CALISTA, la mise en location de votre premier locataire est offerte.' },
      { q: 'Combien prenez-vous pour vendre un bien ?', a: '5 % du prix de vente, TVA (IVA) incluse, à la charge du vendeur. L’acheteur ne paie pas de commission à CALISTA.', link: { href: '/propietarios', label: 'Vendre' } },
      { q: 'Combien coûte une estimation ?', a: 'Cela dépend du bien : nous vous envoyons un devis sans engagement. Nous faisons des estimations pour vendre et pour louer.', link: { href: '/tasaciones', label: 'Estimations' } },
      { q: 'Faites-vous des rapports d’estimation pour une succession réglée en France ?', a: 'Oui. Avec notre agence en France, CALISTA Immobilier (Martinique, www.calista.immo), nous préparons le rapport d’estimation en français pour le notaire.', link: { href: '/tasaciones', label: 'Estimations' } },
      { q: 'Quelle est la durée minimale et maximale en location meublée ?', a: 'De 7 jours à 6 mois, en appartements meublés. Nous louons en direct, sans plateforme ni intermédiaire. Le wifi est inclus ; les autres services dépendent de la durée du séjour.', link: { href: '/alquiler-temporal', label: 'Location meublée' } },
      { q: 'Comment se paie un appartement sur plan à Kalypso Recoleta ?', a: '10 % à la réservation et le solde en 32 mensualités sans intérêts pendant les travaux. La livraison est prévue pour mai 2029.', link: { href: '/desarrollos', label: 'Programmes Kalypso' } },
      { q: 'Dans quelles zones travaillez-vous ?', a: 'À Asunción et dans ses environs.' },
      { q: 'Parlez-vous français ?', a: 'Oui : nous vous accompagnons en français, en espagnol et en anglais.' },
    ],
  },
  en: {
    eyebrow: 'FAQ',
    title: 'What we are asked most',
    lead: 'Clear answers about our services and fees. Can’t find yours? Write to us.',
    mas: 'Learn more',
    wa: 'Ask a question',
    items: [
      { q: 'How much does CALISTA charge to manage a rental?', a: '5 % of the rent actually collected, every month, plus VAT (IVA 10 %). It covers rent collection, the monthly statement, maintenance coordination and dealing with the tenant.', link: { href: '/administracion', label: 'Rental management' } },
      { q: 'How much does it cost to let my property?', a: 'One month’s rent, split 50 % owner and 50 % tenant. It includes finding the tenant, the lease and the move-in inventory. If you bought your property with CALISTA, letting to your first tenant is free.' },
      { q: 'What is your fee for selling a property?', a: '5 % of the sale price, VAT (IVA) included, paid by the seller. The buyer pays no commission to CALISTA.', link: { href: '/propietarios', label: 'Sell' } },
      { q: 'How much does a valuation cost?', a: 'It depends on the property: we send you a no-obligation quote. We value properties for sale and for rent.', link: { href: '/tasaciones', label: 'Valuations' } },
      { q: 'Do you prepare valuation reports for an estate handled in France?', a: 'Yes. Together with our agency in France, CALISTA Immobilier (Martinique, www.calista.immo), we prepare the valuation report in French for the notary.', link: { href: '/tasaciones', label: 'Valuations' } },
      { q: 'What is the minimum and maximum stay for furnished rentals?', a: 'From 7 days to 6 months, in furnished apartments. We rent directly, with no platforms or intermediaries. Wifi is included; other services depend on the length of stay.', link: { href: '/alquiler-temporal', label: 'Furnished rentals' } },
      { q: 'How do I pay for an off-plan apartment at Kalypso Recoleta?', a: '10 % deposit and the balance in 32 interest-free monthly instalments during construction. Delivery is planned for May 2029.', link: { href: '/desarrollos', label: 'Kalypso developments' } },
      { q: 'Which areas do you cover?', a: 'Asunción and its surroundings.' },
      { q: 'Do you speak English?', a: 'Yes: we work in English, Spanish and French.' },
    ],
  },
};
const x = TXT[lang] ?? TXT.es;
const wa = whatsappLink('Hola Calista, tengo una consulta.');
const ld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: x.items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};
---

<Layout title={x.eyebrow} description={x.lead}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">{x.eyebrow}</p>
      <h1>{x.title}</h1>
      <p class="lead">{x.lead}</p>

      <div class="faq">
        {x.items.map((i, n) => (
          <details open={n === 0}>
            <summary>{i.q}</summary>
            <div class="resp">
              <p>{i.a}</p>
              {i.link && <a href={L(i.link.href)}>{i.link.label} →</a>}
            </div>
          </details>
        ))}
      </div>

      <div class="cta">
        <WhatsAppButton href={wa} label={x.wa} />
      </div>
    </div>
  </section>
</Layout>

<style>
  .narrow { max-width: 820px; }
  .faq { margin-top: 2rem; display: grid; gap: 0.8rem; }
  details { background: #fff; border: 1px solid var(--line); border-left: 4px solid var(--violet); border-radius: var(--radius); box-shadow: var(--shadow); }
  summary { cursor: pointer; list-style: none; padding: 1.1rem 3rem 1.1rem 1.3rem; font-weight: 700; color: var(--ink); position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 1.2rem; top: 50%; transform: translateY(-50%); font-size: 1.4rem; color: var(--violet); }
  details[open] summary::after { content: '–'; }
  .resp { padding: 0 1.3rem 1.2rem; }
  .resp p { margin: 0 0 0.6rem; color: var(--muted); line-height: 1.65; }
  .resp a { font-weight: 700; font-size: 0.92rem; }
  .cta { margin-top: 2rem; }
</style>
