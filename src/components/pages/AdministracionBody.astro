---
import Layout from '../../layouts/Layout.astro';
import WhatsAppButton from '../WhatsAppButton.astro';
import { whatsappLink } from '../../lib/whatsapp';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const L = (p: string) => localizePath(p, lang);
// Message en espagnol : c'est l'agence qui le lit
const wa = whatsappLink(t('adm.wa_msg'));
const items = [1, 2, 3, 4, 5, 6].map((n) => ({ t: t(`adm.i${n}_t`), d: t(`adm.i${n}_d`) }));
const tarifas = [1, 2, 3].map((n) => ({ label: t(`adm.t${n}_label`), val: t(`adm.t${n}_val`), d: t(`adm.t${n}_d`) }));
---

<Layout title={t('adm.eyebrow')} description={t('adm.lead')}>
  <section class="section hero">
    <div class="container narrow">
      <p class="eyebrow">{t('adm.eyebrow')}</p>
      <h1>{t('adm.title')}</h1>
      <p class="lead">{t('adm.lead')}</p>
      <div class="cta-linea">
        <WhatsAppButton href={wa} label={t('adm.cta_wa')} />
        <a href="#tarifas" class="btn btn--ghost">{t('adm.cta_tarifas')}</a>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <h2 class="tit">{t('adm.incluye_title')}</h2>
      <ul class="items">
        {items.map((i) => (
          <li>
            <h3>{i.t}</h3>
            <p>{i.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section soft-section">
    <div class="container">
      <div class="soft">
        <p class="eyebrow">{t('adm.soft_eyebrow')}</p>
        <h2>{t('adm.soft_t')}</h2>
        <p>{t('adm.soft_d')}</p>
      </div>
    </div>
  </section>

  <section class="section" id="tarifas">
    <div class="container">
      <h2 class="tit">{t('adm.tarifas_title')}</h2>
      <div class="tarifas">
        {tarifas.map((x, i) => (
          <div class:list={['tarifa', { destacada: i === 0 }]}>
            <p class="t-label">{x.label}</p>
            <p class="t-val">{x.val}</p>
            <p class="t-d">{x.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cierre">
        <h2>{t('adm.cierre_title')}</h2>
        <p>{t('adm.cierre_text')}</p>
        <div class="cta-linea center">
          <WhatsAppButton href={wa} label={t('adm.cta_wa')} />
          <a href={L('/contacto')} class="btn btn--ghost on-dark">{t('prop.cierre_form')}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .narrow { max-width: 760px; }
  .hero { padding-bottom: 1rem; }
  .alt { background: var(--surface); border-block: 1px solid var(--line); }
  .tit { margin: 0 0 1.6rem; padding-left: 0.9rem; border-left: 4px solid var(--violet); }
  .items { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.2rem; }
  .items li { position: relative; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.3rem 1.4rem 1.3rem 3.2rem; box-shadow: var(--shadow); }
  .items li::before {
    content: ''; position: absolute; left: 1.3rem; top: 1.55rem; width: 13px; height: 7px;
    border-left: 2.5px solid var(--violet); border-bottom: 2.5px solid var(--violet); transform: rotate(-45deg);
  }
  .items h3 { margin: 0 0 0.35rem; font-size: 1.05rem; }
  .items p { margin: 0; color: var(--muted); font-size: 0.95rem; }
  .soft-section { padding-bottom: 0; }
  .soft { padding: clamp(1.6rem, 3.5vw, 2.4rem) clamp(1.6rem, 4vw, 2.8rem); background: var(--card-tint); border: 1px solid var(--line); border-left: 5px solid var(--violet); border-radius: var(--radius); box-shadow: var(--shadow); }
  .soft h2 { margin: 0 0 0.6rem; }
  .soft p:not(.eyebrow) { margin: 0; color: var(--ink); line-height: 1.7; max-width: 75ch; }
  .tarifas { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.2rem; }
  .tarifa { background: #fff; border: 1px solid var(--line); border-top: 4px solid var(--violet); border-radius: var(--radius); padding: 1.6rem 1.5rem; box-shadow: var(--shadow); }
  .tarifa.destacada { background: var(--brand); border-color: var(--brand); color: #fff; }
  .t-label { margin: 0; font-weight: 700; font-size: 0.82rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--violet); }
  .destacada .t-label { color: #d9c8ef; }
  .t-val { margin: 0.4rem 0 0.5rem; font-family: var(--display); font-size: 2.4rem; font-weight: 600; line-height: 1.1; color: var(--brand); }
  .destacada .t-val { color: #fff; }
  .t-d { margin: 0; color: var(--muted); }
  .destacada .t-d { color: #e4e1ea; }
  .cta-linea { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.8rem; }
  .cta-linea.center { justify-content: center; }
  .cierre { background: var(--brand); color: #fff; border-radius: var(--radius); padding: clamp(2rem, 5vw, 3.5rem); text-align: center; }
  .cierre h2 { color: #fff; margin-bottom: 0.4rem; }
  .cierre p { color: #d5d9de; margin: 0; }
  .btn.on-dark { background: transparent; color: #fff; border-color: rgba(255, 255, 255, 0.6); }
  .btn.on-dark:hover { background: rgba(255, 255, 255, 0.12); }
  @media (max-width: 820px) { .tarifas { grid-template-columns: 1fr; } }
</style>
