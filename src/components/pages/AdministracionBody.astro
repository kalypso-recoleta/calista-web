---
import Layout from '../../layouts/Layout.astro';
import WhatsAppButton from '../WhatsAppButton.astro';
import EstimacionForm from '../EstimacionForm.astro';
import { whatsappLink } from '../../lib/whatsapp';
import { site } from '../../lib/site';
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const L = (p: string) => localizePath(p, lang);
// Message en espagnol : c'est l'agence qui le lit
const wa = whatsappLink(t('adm.wa_msg'), site.whatsappTemporal);
const items = [1, 2, 3, 4, 5, 6].map((n) => ({ t: t(`adm.i${n}_t`), d: t(`adm.i${n}_d`) }));
const waTemp = whatsappLink(t('adm.temp_wa'), site.whatsappTemporal);
const tempItems = [1, 2, 3, 5, 4].map((n) => t(`adm.temp_i${n}`));
// Chiffres donnés par Hélène (oct. 2026) et soucis du propriétaire à distance
const y = {
  es: {
    stats: [['< 15 días', 'para alquilar tu propiedad, en general'], ['Día 10', 'transferencia de tu alquiler, cada mes (lunes 11 si el 10 cae domingo)'], ['5 %', 'de lo cobrado, más IVA. Si no cobrás, no cobramos.']],
    estimar: 'Estimar mi alquiler gratis',
    pre_eyebrow: 'Propietarios a distancia',
    pre_t: '¿Vivís lejos? Esto es lo que te preocupa, y cómo lo resolvemos.',
    pre: [
      ['¿Va a quedar vacía?', 'En general la alquilamos en menos de 15 días: la publicamos en todos nuestros canales y en los portales.'],
      ['¿Y si el inquilino no paga?', 'Controlamos las garantías antes de firmar y seguimos cualquier atraso con el inquilino. Además, podés asegurar tus alquileres contra el impago (ver más abajo).'],
      ['¿Cuándo y cómo cobro?', 'Te transferimos el alquiler el día 10 de cada mes, con la rendición de cuentas: lo cobrado, lo pagado y nuestra comisión, en guaraníes y en dólares por separado.'],
      ['¿Quién se ocupa de los arreglos?', 'Nosotros: coordinamos el mantenimiento y las reparaciones. Tu inquilino tiene un solo interlocutor, y vos también.'],
      ['¿Cómo sé lo que pasa con mi propiedad?', 'Recibís cada mes el detalle de todo, sin tener que pedirlo, y nos podés escribir en español, francés o inglés.'],
    ],
    liq_alt: "Ejemplo de liquidación mensual al propietario generada por el software de CALISTA, con los nombres ocultos",
    liq_cap: 'Una liquidación real de octubre de 2026 (nombres ocultos): lo cobrado, nuestra comisión y lo que te transferimos.',
    seg: {"eyebrow": "Opcional · Seguro de alquiler impago", "t": "Asegurá tus alquileres contra el impago", "d": "Si querés más tranquilidad, gestionamos por vos un seguro de caución para alquiler con una compañía de seguros del Paraguay, a tu nombre como asegurado.", "items": ["Cubre los alquileres que el inquilino no pague, hasta el límite fijado en la póliza (ampliable hasta 12 meses, con aprobación de la aseguradora).", "Coberturas opcionales, si se contratan: daños al inmueble, gastos comunes ordinarios, agua y electricidad.", "El costo del seguro es a tu cargo: el 3 % del alquiler mensual, descontado cada mes de tus alquileres.", "Si hay un atraso, nosotros hacemos la denuncia del siniestro ante la aseguradora y el seguimiento del trámite."], "nota": "Sujeto a la aprobación del inquilino por la aseguradora y a las condiciones, límites y exclusiones de la póliza emitida. No cubre los honorarios de abogados ni las costas del juicio de desalojo, las expensas extraordinarias, las multas ni los intereses. No aplica al alquiler temporal.", "btn": "Consultar por el seguro de alquiler", "wa": "Hola Calista, quisiera información sobre el seguro de alquiler impago para mi propiedad."},
    est_eyebrow: 'Estimación gratis',
    est_t: '¿Cuánto podrías cobrar de alquiler?',
    est_d: 'Contanos cómo es tu propiedad: te enviamos un rango de alquiler y lo que te quedaría después de la administración.',
  },
  fr: {
    stats: [['< 15 jours', 'pour louer votre bien, en général'], ['Le 10', 'virement de votre loyer, chaque mois (le lundi 11 si le 10 tombe un dimanche)'], ['5 %', 'des loyers encaissés, plus TVA. Pas de loyer encaissé, pas de commission.']],
    estimar: 'Estimer mon loyer gratuitement',
    pre_eyebrow: 'Propriétaires à distance',
    pre_t: 'Vous vivez loin ? Voici ce qui vous inquiète, et comment nous le réglons.',
    pre: [
      ['Mon bien va-t-il rester vide ?', 'En général, nous le louons en moins de 15 jours : nous le publions sur tous nos canaux et sur les portails.'],
      ['Et si le locataire ne paie pas ?', 'Nous contrôlons les garanties avant la signature et suivons tout retard avec le locataire. Vous pouvez aussi assurer vos loyers contre les impayés (voir plus bas).'],
      ['Quand et comment suis-je payé ?', 'Nous vous virons le loyer le 10 de chaque mois, avec le relevé : ce qui a été encaissé, payé, et notre commission, en guaraníes et en dollars séparément.'],
      ['Qui s’occupe des réparations ?', 'Nous : nous coordonnons l’entretien et les réparations. Votre locataire a un seul interlocuteur, et vous aussi.'],
      ['Comment savoir ce qui se passe chez moi ?', 'Vous recevez chaque mois le détail de tout, sans avoir à le demander, et vous pouvez nous écrire en français, espagnol ou anglais.'],
    ],
    liq_alt: "Exemple de relevé mensuel au propriétaire produit par le logiciel de CALISTA, noms masqués",
    liq_cap: 'Un vrai relevé d’octobre 2026 (noms masqués) : ce qui a été encaissé, notre commission et ce que nous vous virons.',
    seg: {"eyebrow": "En option · Assurance loyers impayés", "t": "Assurez vos loyers contre les impayés", "d": "Pour plus de sérénité, nous souscrivons pour vous une assurance caution locative auprès d’une compagnie d’assurance paraguayenne, dont vous êtes l’assuré.", "items": ["Elle couvre les loyers que le locataire ne paie pas, dans la limite fixée par la police (extensible jusqu’à 12 mois, avec l’accord de l’assureur).", "Garanties en option, si elles sont souscrites : dégâts au logement, charges courantes de copropriété, eau et électricité.", "Le coût de l’assurance est à votre charge : 3 % du loyer mensuel, déduit chaque mois de vos loyers.", "En cas de retard, nous déclarons le sinistre à l’assureur et suivons le dossier."], "nota": "Sous réserve de l’acceptation du locataire par l’assureur et des conditions, plafonds et exclusions de la police émise. Ne couvre pas les honoraires d’avocat ni les frais de la procédure d’expulsion, les charges exceptionnelles, les pénalités ni les intérêts. Ne s’applique pas à la location meublée temporaire.", "btn": "Se renseigner sur l’assurance loyers", "wa": "Bonjour Calista, je voudrais des informations sur l’assurance loyers impayés pour mon bien."},
    est_eyebrow: 'Estimation gratuite',
    est_t: 'Quel loyer pourriez-vous obtenir ?',
    est_d: 'Décrivez-nous votre bien : nous vous envoyons une fourchette de loyer et ce qu’il vous resterait après gestion.',
  },
  en: {
    stats: [['< 15 days', 'to rent out your property, as a rule'], ['10th', 'of the month: your rent transferred (Monday the 11th if the 10th is a Sunday)'], ['5 %', 'of the rent collected, plus VAT. No rent collected, no fee.']],
    estimar: 'Estimate my rent for free',
    pre_eyebrow: 'Owners abroad',
    pre_t: 'Live far away? Here is what worries you, and how we handle it.',
    pre: [
      ['Will it stay empty?', 'As a rule, we rent it out in less than 15 days: we list it on all our channels and on the property portals.'],
      ['What if the tenant doesn’t pay?', 'We check the guarantees before signing and follow up any late payment with the tenant. You can also insure your rent against non-payment (see below).'],
      ['When and how do I get paid?', 'We transfer the rent on the 10th of every month, with the statement: what was collected, what was paid and our fee, in guaraníes and dollars separately.'],
      ['Who handles repairs?', 'We do: we coordinate maintenance and repairs. Your tenant has a single point of contact, and so do you.'],
      ['How do I know what’s going on?', 'Every month you receive the full detail, without having to ask, and you can write to us in English, Spanish or French.'],
    ],
    liq_alt: "Example of a monthly owner statement produced by CALISTA's software, with names hidden",
    liq_cap: 'A real statement from October 2026 (names hidden): what was collected, our fee and what we transfer to you.',
    seg: {"eyebrow": "Optional · Rent guarantee insurance", "t": "Insure your rent against non-payment", "d": "For extra peace of mind, we arrange for you a rent guarantee insurance with a Paraguayan insurance company, with you as the insured party.", "items": ["It covers rent the tenant fails to pay, up to the limit set in the policy (extendable up to 12 months, subject to the insurer’s approval).", "Optional covers, if taken out: damage to the property, ordinary building charges, water and electricity.", "The insurance cost is paid by you: 3 % of the monthly rent, deducted each month from your rent.", "If a payment is late, we file the claim with the insurer and follow it through."], "nota": "Subject to the insurer’s approval of the tenant and to the conditions, limits and exclusions of the policy issued. Does not cover lawyers’ fees or eviction court costs, extraordinary building charges, penalties or interest. Does not apply to short-term furnished rentals.", "btn": "Ask about rent insurance", "wa": "Hello Calista, I would like information about rent guarantee insurance for my property."},
    est_eyebrow: 'Free estimate',
    est_t: 'How much rent could you get?',
    est_d: 'Tell us about your property: we send you a rent range and what you would keep after management.',
  },
  pt: {
    stats: [['< 15 dias', 'para alugar o seu imóvel, em geral'], ['Dia 10', 'transferência do seu aluguel, todo mês (segunda-feira, dia 11, se o dia 10 cair num domingo)'], ['5 %', 'dos aluguéis recebidos, mais IVA. Se você não recebe, nós não cobramos.']],
    estimar: 'Estimar o meu aluguel grátis',
    pre_eyebrow: 'Proprietários à distância',
    pre_t: 'Mora longe? Veja o que preocupa você e como resolvemos.',
    pre: [
      ['O meu imóvel vai ficar vazio?', 'Em geral, alugamos em menos de 15 dias: anunciamos em todos os nossos canais e nos portais.'],
      ['E se o inquilino não pagar?', 'Verificamos as garantias antes da assinatura e acompanhamos qualquer atraso com o inquilino. Você também pode segurar os seus aluguéis contra inadimplência (veja abaixo).'],
      ['Quando e como eu recebo?', 'Transferimos o aluguel no dia 10 de cada mês, com a prestação de contas: o que foi recebido, o que foi pago e a nossa comissão, em guaranis e em dólares separadamente.'],
      ['Quem cuida dos reparos?', 'Nós: coordenamos a manutenção e os reparos. O seu inquilino tem um único interlocutor, e você também.'],
      ['Como sei o que acontece no meu imóvel?', 'Todo mês você recebe o detalhe de tudo, sem precisar pedir, e pode nos escrever em espanhol, francês ou inglês.'],
    ],
    liq_alt: "Exemplo de prestação de contas mensal ao proprietário gerada pelo software da CALISTA, com os nomes ocultos",
    liq_cap: 'Uma prestação de contas real de outubro de 2026 (nomes ocultos): o que foi recebido, a nossa comissão e o que transferimos para você.',
    seg: {"eyebrow": "Opcional · Seguro contra inadimplência", "t": "Segure os seus aluguéis contra inadimplência", "d": "Para mais tranquilidade, contratamos para você um seguro-fiança de aluguel com uma seguradora do Paraguai, com você como segurado.", "items": ["Cobre os aluguéis que o inquilino não pagar, até o limite fixado na apólice (ampliável até 12 meses, com aprovação da seguradora).", "Coberturas opcionais, se contratadas: danos ao imóvel, despesas ordinárias de condomínio, água e luz.", "O custo do seguro fica por sua conta: 3 % do aluguel mensal, descontado todo mês dos seus aluguéis.", "Se houver atraso, nós comunicamos o sinistro à seguradora e acompanhamos o processo."], "nota": "Sujeito à aprovação do inquilino pela seguradora e às condições, limites e exclusões da apólice emitida. Não cobre honorários de advogados nem custas da ação de despejo, despesas extraordinárias de condomínio, multas nem juros. Não se aplica ao aluguel temporário.", "btn": "Consultar sobre o seguro de aluguel", "wa": "Olá Calista, gostaria de informações sobre o seguro contra inadimplência para o meu imóvel."},
    est_eyebrow: 'Estimativa grátis',
    est_t: 'Quanto você poderia receber de aluguel?',
    est_d: 'Conte como é o seu imóvel: enviamos uma faixa de aluguel e quanto sobraria para você depois da administração.',
  },
}[lang as 'es' | 'fr' | 'en' | 'pt']!;
const tarifas = [1, 2, 3].map((n) => ({ label: t(`adm.t${n}_label`), val: t(`adm.t${n}_val`), d: t(`adm.t${n}_d`) }));
---

<Layout zona title={t('adm.eyebrow')} description={t('adm.lead')}>
  <section class="section hero">
    <div class="container hero-c">
      <p class="eyebrow">{t('adm.eyebrow')}</p>
      <h1>{t('adm.title')}</h1>
      <p class="lead">{t('adm.lead')}</p>
      <ul class="stats">
        {y.stats.map(([v, l]) => <li><span class="sv">{v}</span><span class="sl">{l}</span></li>)}
      </ul>
      <div class="cta-linea">
        <a href="#estimacion" class="btn btn--primary">{y.estimar}</a>
        <WhatsAppButton href={wa} label={t('adm.cta_wa')} />
        <a href="#tarifas" class="btn btn--ghost">{t('adm.cta_tarifas')}</a>
      </div>
    </div>
  </section>

  <section class="section pre-sec">
    <div class="container">
      <p class="eyebrow">{y.pre_eyebrow}</p>
      <h2 class="tit">{y.pre_t}</h2>
      <dl class="preocupaciones">
        {y.pre.map(([q, a]) => <div><dt>{q}</dt><dd>{a}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <h2 class="tit">{t('adm.incluye_title')}</h2>
      <ul class="items">
        {items.map((i) => (
          <li>
            <h3>{i.t}</h3>
            <p>{i.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section soft-section">
    <div class="container">
      <div class="soft">
        <p class="eyebrow">{t('adm.soft_eyebrow')}</p>
        <h2>{t('adm.soft_t')}</h2>
        <p>{t('adm.soft_d')}</p>
        <figure class="liq">
          <img src="/img/liquidacion-ejemplo.webp" alt={y.liq_alt} width="1100" height="795" loading="lazy" />
          <figcaption>{y.liq_cap}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section" id="tarifas">
    <div class="container">
      <h2 class="tit">{t('adm.tarifas_title')}</h2>
      <div class="tarifas">
        {tarifas.map((x, i) => (
          <div class:list={['tarifa', { destacada: i === 0 }]}>
            <p class="t-label">{x.label}</p>
            <p class="t-val">{x.val}</p>
            <p class="t-d">{x.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section seg-sec" id="seguro-alquiler">
    <div class="container">
      <div class="seg">
        <p class="eyebrow">{y.seg.eyebrow}</p>
        <h2>{y.seg.t}</h2>
        <p class="seg-d">{y.seg.d}</p>
        <ul class="seg-list">{y.seg.items.map((i) => <li>{i}</li>)}</ul>
        <p class="seg-nota">{y.seg.nota}</p>
        <div class="cta-linea"><WhatsAppButton href={whatsappLink(y.seg.wa, site.whatsappTemporal)} label={y.seg.btn} /></div>
      </div>
    </div>
  </section>

  <section class="section est-sec" id="estimacion">
    <div class="container est-grid">
      <div>
        <p class="eyebrow">{y.est_eyebrow}</p>
        <h2>{y.est_t}</h2>
        <p class="lead">{y.est_d}</p>
      </div>
      <EstimacionForm />
    </div>
  </section>

  <section class="section alt" id="temporal">
    <div class="container">
      <div class="temp">
        <div class="temp-txt">
          <p class="eyebrow">{t('adm.temp_eyebrow')}</p>
          <h2>{t('adm.temp_t')}</h2>
          <p class="temp-d">{t('adm.temp_d')}</p>
          <ul class="temp-list">
            {tempItems.map((i) => <li>{i}</li>)}
          </ul>
          <div class="cta-linea">
            <WhatsAppButton href={waTemp} label={t('adm.temp_btn')} />
            <a href={L('/alquiler-temporal/otros-departamentos')} class="btn btn--ghost">{t('adm.temp_cta')}</a>
          </div>
        </div>
        <div class="tarifa destacada temp-precio">
          <p class="t-label">{t('adm.temp_label')}</p>
          <p class="t-val">{t('adm.temp_val')}</p>
          <p class="t-d">{t('adm.temp_val_d')}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cierre">
        <h2>{t('adm.cierre_title')}</h2>
        <p>{t('adm.cierre_text')}</p>
        <div class="cta-linea center">
          <WhatsAppButton href={wa} label={t('adm.cta_wa')} />
          <a href={L('/contacto')} class="btn btn--ghost on-dark">{t('prop.cierre_form')}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-c > h1, .hero-c > .lead { max-width: 820px; }
  .alt { background: var(--surface); border-block: 1px solid var(--line); }
  .tit { margin: 0 0 1.6rem; padding-left: 0.9rem; border-left: 4px solid var(--violet); }
  .items { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.2rem; }
  .items li { position: relative; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.3rem 1.4rem 1.3rem 3.2rem; box-shadow: var(--shadow); }
  .items li::before {
    content: ''; position: absolute; left: 1.3rem; top: 1.55rem; width: 13px; height: 7px;
    border-left: 2.5px solid var(--violet); border-bottom: 2.5px solid var(--violet); transform: rotate(-45deg);
  }
  .items h3 { margin: 0 0 0.35rem; font-size: 1.05rem; }
  .items p { margin: 0; color: var(--muted); font-size: 0.95rem; }
  .soft-section { padding-bottom: 0; }
  .soft { padding: clamp(1.6rem, 3.5vw, 2.4rem) clamp(1.6rem, 4vw, 2.8rem); background: var(--card-tint); border: 1px solid var(--line); border-left: 5px solid var(--violet); border-radius: var(--radius); box-shadow: var(--shadow); }
  .soft h2 { margin: 0 0 0.6rem; }
  .liq { margin: 1.6rem 0 0; }
  .liq img { width: 100%; max-width: 760px; height: auto; display: block; border-radius: var(--radius-sm); box-shadow: var(--shadow-lg); border: 1px solid var(--line); }
  .liq figcaption { margin-top: 0.7rem; font-size: 0.88rem; color: var(--muted); }
  .soft p:not(.eyebrow) { margin: 0; color: var(--ink); line-height: 1.7; max-width: 75ch; }
  .tarifas { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.2rem; }
  .tarifa { background: #fff; border: 1px solid var(--line); border-top: 4px solid var(--violet); border-radius: var(--radius); padding: 1.6rem 1.5rem; box-shadow: var(--shadow); }
  .tarifa.destacada { background: var(--brand); border-color: var(--brand); color: #fff; }
  .t-label { margin: 0; font-weight: 700; font-size: 0.82rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--violet); }
  .destacada .t-label { color: #d9c8ef; }
  .t-val { margin: 0.4rem 0 0.5rem; font-family: var(--display); font-size: 2.4rem; font-weight: 600; line-height: 1.1; color: var(--brand); }
  .destacada .t-val { color: #fff; }
  .t-d { margin: 0; color: var(--muted); }
  .destacada .t-d { color: #e4e1ea; }
  .cta-linea { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.8rem; }
  .cta-linea.center { justify-content: center; }
  .cierre { background: var(--brand); color: #fff; border-radius: var(--radius); padding: clamp(2rem, 5vw, 3.5rem); text-align: center; }
  .cierre h2 { color: #fff; margin-bottom: 0.4rem; }
  .cierre p { color: #d5d9de; margin: 0; }
  .btn.on-dark { background: transparent; color: #fff; border-color: rgba(255, 255, 255, 0.6); }
  .btn.on-dark:hover { background: rgba(255, 255, 255, 0.12); }
  .temp { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .temp h2 { margin: 0 0 0.6rem; }
  .temp-d { color: var(--muted); margin: 0 0 1rem; max-width: 65ch; }
  .temp-list { margin: 0 0 0.8rem; padding-left: 1.2rem; }
  .temp-list li { margin: 0.3rem 0; }
  .temp .cta-linea { margin-top: 1.4rem; }
  .stats { list-style: none; margin: 1.6rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8rem; }
  .stats li { background: #fff; border: 1px solid var(--line); border-top: 4px solid var(--violet); border-radius: var(--radius); padding: 0.9rem 1.1rem; display: flex; flex-direction: column; gap: 0.3rem; box-shadow: var(--shadow); }
  .sv { font-size: 1.5rem; font-weight: 700; color: var(--violet); line-height: 1.1; }
  .sl { font-size: 0.85rem; color: var(--muted); line-height: 1.35; }
  /* 5 encadrés sans trou : 3 en haut, 2 en bas (grille de 6 colonnes) */
  .preocupaciones { margin: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 1rem 1.2rem; }
  .preocupaciones > div { grid-column: span 2; }
  .preocupaciones > div:nth-child(n + 4) { grid-column: span 3; }
  section.hero { padding-bottom: 0; }
  section.pre-sec { padding-top: clamp(2.5rem, 4vw, 3.25rem); }
  .preocupaciones div { padding: 1.1rem 1.2rem; border-left: 3px solid var(--violet); background: #fff; border-radius: 0 var(--radius-sm) var(--radius-sm) 0; }
  .preocupaciones dt { font-weight: 700; color: var(--brand); margin-bottom: 0.35rem; }
  .preocupaciones dd { margin: 0; color: var(--muted); }
  .seg { padding: clamp(1.6rem, 3.5vw, 2.4rem) clamp(1.6rem, 4vw, 2.8rem); background: #fff; border: 1px solid var(--line); border-top: 4px solid var(--violet); border-radius: var(--radius); box-shadow: var(--shadow); }
  .seg h2 { margin: 0 0 0.6rem; }
  .seg-d { margin: 0 0 1rem; max-width: 75ch; }
  .seg-list { margin: 0 0 1rem; padding-left: 1.2rem; max-width: 80ch; }
  .seg-list li { margin: 0.4rem 0; }
  .seg-nota { margin: 0; font-size: 0.85rem; color: var(--muted); max-width: 80ch; }
  .seg .cta-linea { margin-top: 1.2rem; }
  .est-sec { background: var(--violet-soft); }
  .est-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }
