---
/** Bandeau d'accès à la page Areguá Forest, en tête de la page Terrenos. */
import { textos } from './textos';
import { img } from '../../lib/cloudinary';
import { getLangFromUrl, localizePath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const c = textos[lang] ?? textos.es;
const href = localizePath('/terrenos/aregua-forest', lang);
---

<a class="banner" href={href}>
  <img src={img('/uploads/aregua-forest-02.jpg', { w: 1200, h: 400 })} alt="" width="1200" height="400" loading="eager" />
  <div class="txt">
    <strong>{c.banner_t}</strong>
    <span>{c.banner_d}</span>
    <em class="btn btn--primary">{c.banner_btn} →</em>
  </div>
</a>

<style>
  .banner { position: relative; display: block; border-radius: var(--radius); overflow: hidden; margin: 0 0 2.5rem; color: #fff; box-shadow: var(--shadow-lg); text-decoration: none; }
  .banner img { width: 100%; height: 260px; object-fit: cover; transition: transform 0.4s ease; }
  .banner:hover img { transform: scale(1.03); }
  .banner::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(62, 0, 85, 0.88) 0%, rgba(62, 0, 85, 0.55) 55%, rgba(0, 0, 0, 0) 100%); }
  .txt { position: absolute; inset: 0; z-index: 1; display: flex; flex-direction: column; justify-content: center; gap: 0.5rem; padding: 1.5rem 2rem; max-width: 560px; }
  .txt strong { font-size: clamp(1.3rem, 2.6vw, 1.8rem); line-height: 1.2; }
  .txt span { opacity: 0.92; }
  .txt em { font-style: normal; align-self: flex-start; margin-top: 0.4rem; }
  @media (max-width: 600px) { .banner img { height: 300px; } .txt { padding: 1.2rem; } }
</style>
