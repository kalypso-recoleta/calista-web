---
import { site } from '../lib/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BarraMovil from '../components/BarraMovil.astro';
import { numeroPorRuta } from '../lib/whatsapp';
import { recortar } from '../lib/seo';
import {
  getLangFromUrl,
  useTranslations,
  localizePath,
  stripLocale,
  LOCALES,
} from '../i18n/utils';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string; // URL absolue pour l'aperçu de partage
  noindex?: boolean; // pages sans intérêt SEO (ex. page de remerciement)
  ogType?: 'website' | 'article'; // « article » pour les articles du blog
  publishedTime?: Date; // date de publication (articles)
  tituloCompleto?: boolean; // true = titre déjà complet (fiches de biens) : pas de « · Calista Inmobiliaria »
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title,
  description: descriptionBruta = site.lema,
  image,
  noindex = false,
  ogType = 'website',
  publishedTime,
  tituloCompleto = false,
} = Astro.props;

const pageTitle = title ? (tituloCompleto ? title : `${title} · CALISTA`) /* suffixe court : Google coupe vers 60 caractères */ : site.nombre;
// Description coupée à ~155 caractères (au-delà, Google la tronque)
const description = recortar(descriptionBruta);
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = image
  ? new URL(image, Astro.site).toString()
  : new URL('/og-default.png', Astro.site).toString();

// Liens hreflang (es / fr / en) pour la même page
const basePath = stripLocale(Astro.url.pathname);
const alternates = LOCALES.map((l) => ({
  lang: l,
  href: new URL(localizePath(basePath, l), Astro.site).toString(),
}));

// og:locale (langue de la page + langues alternatives)
const OG_LOCALE: Record<string, string> = { es: 'es_ES', fr: 'fr_FR', en: 'en_US' };
const ogLocale = OG_LOCALE[lang];
const ogLocaleAlt = LOCALES.filter((l) => l !== lang).map((l) => OG_LOCALE[l]);

// Données structurées : l'agence immobilière (présent sur toutes les pages).
// Aide Google à comprendre l'entreprise, sa localisation et ses coordonnées.
const siteUrl = new URL('/', Astro.site).toString().replace(/\/$/, '');
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  name: site.nombre,
  url: siteUrl,
  image: new URL('/og-default.png', Astro.site).toString(),
  logo: new URL('/logo-calista.png', Astro.site).toString(),
  telephone: '+' + site.whatsapp,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Auditores de la Guerra del Chaco esq. Tte. 2do Rufino Cañete, Barrio Mburucuyá',
    addressLocality: 'Asunción',
    addressCountry: 'PY',
  },
  areaServed: ['Asunción', 'Gran Asunción', 'Paraguay'],
  knowsLanguage: ['es', 'fr', 'en'],
  // Description dans la langue de la page (mentionne les langues parlées)
  description: t('seo.home_desc'),
  // Profils officiels de l'agence (aide les moteurs et les IA à relier les sources)
  sameAs: [site.googleResenas, site.instagram, site.facebook].filter(Boolean),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Google Search Console (validation du site) -->
    <meta name="google-site-verification" content="o8mSsXQCcjD4vAhIkumYZtiCSneSE1JHhsBfyRLHz-w" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.lang} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="theme-color" content="#3e0055" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- Aperçu de partage (WhatsApp, réseaux) -->
    <meta property="og:type" content={ogType} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlt.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Statistiques Plausible (sans cookies, donc sans bandeau d'accord) -->
    <script is:inline async src="https://plausible.io/js/pa-8tCHVoGD4U5b-mNJN2K22.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>

    <!-- Données structurées : agence immobilière (toutes les pages) -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

    <!-- Police : police système (comme le logiciel CALISTA) — aucun chargement externe -->
    <!-- Active les animations seulement si le navigateur le permet -->
    <script is:inline>
      if (
        'IntersectionObserver' in window &&
        !matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        document.documentElement.classList.add('anim');
      }
    </script>
  </head>
  <body data-wa={numeroPorRuta(basePath.replace(/\/$/, '') || '/')}>
    <a href="#contenido" class="skip-link">{t('nav.skip')}</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <BarraMovil />

    <script>
      // Code de page au début des messages WhatsApp pré-remplis : la personne qui répond
      // sait d'où vient le contact (ex. « [WEB-ADMINISTRACION] » ou « [WEB-BLOG-FR] »).
      // Les liens de partage (wa.me/?text=…, sans numéro) ne sont pas modifiés.
      try {
        const partes = location.pathname.split('/').filter(Boolean);
        const lang = ['fr', 'en'].includes(partes[0]) ? partes.shift()!.toUpperCase() : '';
        const seccion = (partes[0] || 'inicio').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toUpperCase();
        const codigo = `[WEB-${seccion}${lang ? '-' + lang : ''}]`;
        document.querySelectorAll<HTMLAnchorElement>('a[href^="https://wa.me/"]').forEach((a) => {
          const u = new URL(a.href);
          if (u.pathname === '/' || u.pathname === '') return;
          // Statistiques : chaque clic WhatsApp est compté (objectif « WhatsApp » dans Plausible)
          a.addEventListener('click', () => {
            const numero = u.pathname.replace('/', '');
            (window as any).plausible?.('WhatsApp', { props: { pagina: codigo, numero: numero.endsWith('333003') ? 'Hélène' : 'general' } });
          });
          const texto = u.searchParams.get('text') ?? '';
          if (texto.startsWith('[WEB-')) return;
          // encodeURIComponent (et non searchParams) : WhatsApp lit « %20 », pas toujours « + »
          a.href = `https://wa.me${u.pathname}?text=${encodeURIComponent(`${codigo} ${texto}`.trim())}`;
        });
        // Statistiques : clics vers la fiche / les avis Google (objectif « Reseñas Google »)
        document.querySelectorAll<HTMLAnchorElement>('a[href*="maps.app.goo.gl"], a[href*="g.page/"]').forEach((a) => {
          a.addEventListener('click', () => (window as any).plausible?.('Reseñas Google', { props: { pagina: codigo } }));
        });

        // ─── Formulaires → WhatsApp ───
        // Tant que la détection des formulaires Netlify n'est pas active, les envois Netlify
        // se perdent. À l'envoi, on ouvre donc WhatsApp avec la demande déjà rédigée
        // (numéro : data-wa-numero du formulaire, sinon celui de la page),
        // et on envoie aussi une copie à Netlify (sera reçue dès que la détection sera activée).
        const AVISO: Record<string, string> = {
          '': 'Al enviar, se abre WhatsApp con tu mensaje listo: solo tenés que tocar «Enviar».',
          FR: 'En validant, WhatsApp s’ouvre avec votre message déjà rédigé : il suffit d’appuyer sur « Envoyer ».',
          EN: 'When you submit, WhatsApp opens with your message ready: just tap “Send”.',
        };
        const OMITIR = ['form-name', 'bot-field', 'idioma', 'acepto'];
        document.querySelectorAll<HTMLFormElement>('form[data-netlify]').forEach((form) => {
          const boton = form.querySelector('button[type="submit"]');
          if (boton) {
            const aviso = document.createElement('p');
            aviso.className = 'aviso-wa';
            aviso.textContent = AVISO[lang] ?? AVISO[''];
            aviso.style.cssText = 'margin:0;font-size:.85rem;color:var(--muted)';
            boton.insertAdjacentElement('beforebegin', aviso);
          }
          form.addEventListener('submit', (e) => {
            e.preventDefault();
            const datos = new FormData(form);
            const lineas: string[] = [];
            let titulo = form.dataset.waTitulo ?? '';
            for (const [nombre, valor] of datos.entries()) {
              const v = String(valor).trim();
              if (!v || OMITIR.includes(nombre)) continue;
              const campo = form.querySelector<HTMLElement>(`[name="${nombre}"]`);
              if (campo instanceof HTMLInputElement && campo.type === 'hidden') { titulo = titulo || v; continue; }
              const etiqueta = campo?.closest('label')?.querySelector('span')?.textContent?.trim()
                ?? campo?.closest('fieldset')?.querySelector('legend')?.textContent?.trim()
                ?? nombre;
              lineas.push(`${etiqueta}: ${v}`);
            }
            const mensaje = [`${codigo} ${titulo}`.trim(), '', ...lineas].join('\n');
            const numero = form.dataset.waNumero || document.body.dataset.wa || '';
            // Copie à Netlify (sans attendre ; ignorée tant que la détection est désactivée)
            try { navigator.sendBeacon('/', new URLSearchParams(datos as any)); } catch {}
            (window as any).plausible?.('Formulario', { props: { pagina: codigo, formulario: form.getAttribute('name') ?? '' } });
            location.href = `https://wa.me/${numero}?text=${encodeURIComponent(mensaje)}`;
          });
        });
      } catch {
        // En cas de souci, les liens et formulaires restent tels quels.
      }
    </script>

    <script>
      // Révélation au scroll
      const SEL =
        '.hero-text, .hero-media, .cats > .cat, .row-head, .cab, .grid-biens > *, .porque-intro, .valores > li, .testimonios > .testi, .pasos > li, .incluye > li, .prop-band, .cierre, .gallery, .specs, .cta-card';
      try {
        if (
          document.documentElement.classList.contains('anim') &&
          'IntersectionObserver' in window
        ) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                if (e.isIntersecting) {
                  e.target.classList.add('is-visible');
                  io.unobserve(e.target);
                }
              }
            },
            { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
          );
          document.querySelectorAll(SEL).forEach((el) => io.observe(el));
        }
      } catch {
        // En cas de souci, on révèle tout (rien ne reste caché)
        document.documentElement.classList.remove('anim');
      }
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -999px;
        top: 0;
        background: var(--brand);
        color: #fff;
        padding: 0.6rem 1rem;
        z-index: 100;
        border-radius: 0 0 8px 0;
      }
      .skip-link:focus {
        left: 0;
      }
    </style>
  </body>
</html>
